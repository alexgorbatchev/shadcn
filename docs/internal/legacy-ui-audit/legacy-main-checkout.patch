@@ -0,0 +1,31 @@
+import { resolve } from "node:path";
+
+type VendorBuild = { name: string; cwd: string; command: string[] };
+
+const root = resolve(import.meta.dir, "..");
+const bin = (name: string): string => resolve(root, "node_modules/.bin", name);
+
+// Each fork builds with its own upstream build configuration; only the TypeScript 6 deprecation shim lives here.
+const builds: VendorBuild[] = [
+  {
+    name: "@shadcn/react",
+    cwd: resolve(root, "vendor/shadcn-ui/packages/react"),
+    command: [bin("tsup"), "--tsconfig", resolve(root, "scripts/vendor/shadcn-react.tsconfig.json")],
+  },
+  { name: "sonner", cwd: resolve(root, "vendor/sonner"), command: [bin("bunchee")] },
+];
+
+for (const build of builds) {
+  if (!(await Bun.file(resolve(build.cwd, "package.json")).exists())) {
+    throw new Error(`${build.name} fork is missing at ${build.cwd}. Run: git submodule update --init`);
+  }
+  const child = Bun.spawn(build.command, { cwd: build.cwd, stdout: "inherit", stderr: "inherit" });
+  if ((await child.exited) !== 0) {
+    throw new Error(`${build.name} fork build failed with exit code ${child.exitCode}`);
+  }
+}
+await Bun.write(
+  resolve(root, "vendor/sonner/dist/styles.css"),
+  Bun.file(resolve(root, "vendor/sonner/src/styles.css")),
+);
+console.log(`Built ${builds.length} vendored fork(s).`);
