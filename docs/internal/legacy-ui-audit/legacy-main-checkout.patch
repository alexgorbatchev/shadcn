@@ -0,0 +1,81 @@
+import { expect, test } from "vitest";
+import { page } from "vitest/browser";
+import { render, type RenderResult } from "vitest-browser-react";
+import { Alert, AlertAction, AlertTitle } from "../Alert";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import "../../../.storybook/preview.css";
+
+type Direction = "ltr" | "rtl";
+
+interface IActionLayout {
+  screen: RenderResult;
+  alertRect: DOMRect;
+  titleRect: DOMRect;
+  titleTextRect: DOMRect;
+  titleLineCentre: number;
+  buttonRect: DOMRect;
+}
+
+const DENSITIES = ["comfortable", "compact"] as const;
+
+async function renderAlertWithAction(
+  density: (typeof DENSITIES)[number],
+  direction: Direction,
+): Promise<IActionLayout> {
+  await page.viewport(480, 320);
+  const screen = await render(
+    <DensityProvider density={density}>
+      <div dir={direction} className="w-96">
+        <Alert>
+          <AlertTitle>Message archived after the retention window closed for this workspace</AlertTitle>
+          <AlertAction>
+            <Button size="xs">Undo</Button>
+          </AlertAction>
+        </Alert>
+      </div>
+    </DensityProvider>,
+  );
+  const title = page.getByText(/^Message archived/).element();
+  const titleText = document.createRange();
+  titleText.selectNodeContents(title);
+  const titleRect = title.getBoundingClientRect();
+
+  return {
+    screen,
+    alertRect: screen.container.querySelector('[data-slot="alert"]')!.getBoundingClientRect(),
+    titleRect,
+    titleTextRect: titleText.getBoundingClientRect(),
+    titleLineCentre: titleRect.top + Number.parseFloat(getComputedStyle(title).lineHeight) / 2,
+    buttonRect: page.getByRole("button", { name: "Undo" }).element().getBoundingClientRect(),
+  };
+}
+
+test.each(DENSITIES)("%s alert action is centred on the first title line", async (density) => {
+  const { screen, titleLineCentre, buttonRect } = await renderAlertWithAction(density, "ltr");
+
+  expect(buttonRect.top + buttonRect.height / 2).toBeCloseTo(titleLineCentre, 1);
+  await screen.unmount();
+});
+
+test.each(DENSITIES)(
+  "%s left-to-right alert action is inset like the content and clear of the title",
+  async (density) => {
+    const { screen, alertRect, titleRect, titleTextRect, buttonRect } = await renderAlertWithAction(density, "ltr");
+
+    expect(alertRect.right - buttonRect.right).toBeCloseTo(titleRect.left - alertRect.left, 1);
+    expect(titleTextRect.right).toBeLessThanOrEqual(buttonRect.left);
+    await screen.unmount();
+  },
+);
+
+test.each(DENSITIES)(
+  "%s right-to-left alert action is inset like the content and clear of the title",
+  async (density) => {
+    const { screen, alertRect, titleRect, titleTextRect, buttonRect } = await renderAlertWithAction(density, "rtl");
+
+    expect(buttonRect.left - alertRect.left).toBeCloseTo(alertRect.right - titleRect.right, 1);
+    expect(titleTextRect.left).toBeGreaterThanOrEqual(buttonRect.right);
+    await screen.unmount();
+  },
+);
diff --git a/src/components/__tests__/Attachment.test.tsx b/src/components/__tests__/Attachment.test.tsx
new file mode 100644
index 0000000..27b2840
--- /dev/null
