@@ -0,0 +1,85 @@
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import { DensityProvider } from "../DensityProvider";
+import { Slider } from "../Slider";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, countChangedPixels, measureOverflow } from "./helpers";
+import "../../../.storybook/preview.css";
+
+type Theme = "light" | "dark";
+
+// Multiplies opacity up the ancestor chain, which is how the browser composites nested translucent layers.
+function readEffectiveOpacity(element: Element): number {
+  let opacity = 1;
+  for (let current: Element | null = element; current; current = current.parentElement) {
+    opacity *= Number(getComputedStyle(current).opacity);
+  }
+  return opacity;
+}
+
+test.each(["light", "dark"] satisfies Theme[])(
+  "keyboard focus on a slider thumb changes the rendered thumb in %s theme",
+  async (theme) => {
+    await page.viewport(480, 240);
+    const screen = await render(
+      <ThemeProvider forcedTheme={theme}>
+        <DensityProvider density="comfortable">
+          <div data-testid="surface" className="w-64 bg-background p-6">
+            <Slider defaultValue={50} getAriaLabel={() => "Volume"} />
+          </div>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const wrapper = screen.getByTestId("surface").element() as HTMLElement;
+    const input = screen.getByRole("slider", { name: "Volume" }).element();
+
+    const resting = await captureImageData(wrapper);
+    expect(countChangedPixels(resting, await captureImageData(wrapper))).toBe(0);
+
+    await userEvent.tab();
+    expect(document.activeElement).toBe(input);
+    expect(input.matches(":focus-visible")).toBe(true);
+    await expect.poll(async () => countChangedPixels(resting, await captureImageData(wrapper))).toBeGreaterThan(0);
+    await screen.unmount();
+  },
+);
+
+test("a disabled slider dims its thumb and track once, like other disabled controls", async () => {
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <Slider defaultValue={50} disabled getAriaLabel={() => "Volume"} />
+    </ThemeProvider>,
+  );
+  const input = screen.getByRole("slider", { name: "Volume" }).element();
+  const thumb = input.closest('[data-slot="slider-thumb"]');
+  const track = document.querySelector('[data-slot="slider-track"]');
+  if (!thumb || !track) {
+    throw new Error("Expected a slider thumb and track");
+  }
+
+  expect(readEffectiveOpacity(track)).toBeCloseTo(0.5);
+  expect(readEffectiveOpacity(thumb)).toBeCloseTo(0.5);
+  await screen.unmount();
+});
+
+// Base UI positions thumbs absolutely, so only the slider's own box can reserve their space in the surrounding layout.
+test("the slider box contains its thumbs at either orientation and every position", async () => {
+  for (const orientation of ["horizontal", "vertical"] as const) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <div className="flex h-48 w-64">
+          <Slider defaultValue={[0, 50, 100]} orientation={orientation} getAriaLabel={(index) => `Thumb ${index}`} />
+        </div>
+      </ThemeProvider>,
+    );
+    const slider = document.querySelector("[data-slot=slider]")!;
+    const thumbs = [...document.querySelectorAll("[data-slot=slider-thumb]")];
+
+    expect({ orientation, overflows: thumbs.map((thumb) => measureOverflow(thumb, slider)) }).toEqual({
+      orientation,
+      overflows: [0, 0, 0],
+    });
+    await screen.unmount();
+  }
+});
