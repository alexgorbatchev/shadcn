+
+// Measures the main region against the viewport edge away from the panel and against the panel's inner edge.
+async function expectInsetBesidePanel(canvasElement: HTMLElement, side: "left" | "right", gaps: InsetGaps) {
+  const canvas = within(canvasElement);
+  const panel = canvas.getByRole("complementary", { name: "Project navigation" });
+  const inset = canvas.getByRole("main");
+  const viewportWidth = canvasElement.ownerDocument.documentElement.clientWidth;
+  await waitFor(() => {
+    const panelBounds = panel.getBoundingClientRect();
+    const insetBounds = inset.getBoundingClientRect();
+    if (side === "right") {
+      expect(viewportWidth - panelBounds.right).toBe(0);
+      expect(insetBounds.left).toBe(gaps.outer);
+      expect(panelBounds.left - insetBounds.right).toBe(gaps.panel);
+    } else {
+      expect(panelBounds.left).toBe(0);
+      expect(viewportWidth - insetBounds.right).toBe(gaps.outer);
+      expect(insetBounds.left - panelBounds.right).toBe(gaps.panel);
+    }
+  });
+}
+
