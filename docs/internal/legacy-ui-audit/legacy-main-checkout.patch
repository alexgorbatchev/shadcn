+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import { Combobox, ComboboxContent, ComboboxInput, ComboboxItem, ComboboxList } from "../Combobox";
+import { DirectionProvider } from "../DirectionProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type Direction = "ltr" | "rtl";
+
+const TECHNOLOGIES = ["Bun", "Deno", "Node.js"];
+
+function renderCombobox(
+  direction: Direction,
+  frameClassName: string,
+  wrapperClassName = "p-4",
+): ReturnType<typeof render> {
+  return render(
+    <ThemeProvider forcedTheme="light">
+      <DirectionProvider direction={direction}>
+        <div dir={direction} className={wrapperClassName}>
+          <Combobox items={TECHNOLOGIES}>
+            <ComboboxInput aria-label="Technology" frameClassName={frameClassName} />
+            <ComboboxContent>
+              <ComboboxList>
+                {(item: string) => (
+                  <ComboboxItem key={item} value={item}>
+                    {item}
+                  </ComboboxItem>
+                )}
+              </ComboboxList>
+            </ComboboxContent>
+          </Combobox>
+        </div>
+      </DirectionProvider>
+    </ThemeProvider>,
+  );
+}
+
+async function openPopup(): Promise<{ frame: DOMRect; popup: DOMRect }> {
+  const input = page.getByRole("combobox", { name: "Technology" }).element();
+  const frame = input.closest('[data-slot="input-group"]');
+  if (!frame) {
+    throw new Error("Expected the combobox input inside its field frame");
+  }
+  await userEvent.click(input);
+  const option = await page.getByRole("option", { name: "Bun" }).findElement();
+  const popup = option.closest('[data-slot="combobox-content"]');
+  if (!popup) {
+    throw new Error("Expected the option inside the combobox popup");
+  }
+  await expect.poll(() => popup.getAnimations().length).toBe(0);
+  return { frame: frame.getBoundingClientRect(), popup: popup.getBoundingClientRect() };
+}
+
+test.each(["ltr", "rtl"] satisfies Direction[])(
+  "the combobox popup spans exactly the field frame in %s direction",
+  async (direction) => {
+    await page.viewport(800, 480);
+    const screen = await renderCombobox(direction, "w-64");
+
+    const { frame, popup } = await openPopup();
+
+    expect(popup.left).toBeCloseTo(frame.left, 0);
+    expect(popup.right).toBeCloseTo(frame.right, 0);
+    await screen.unmount();
+  },
+);
+
+test("the combobox popup stays inside a narrow viewport when the field frame fills it", async () => {
+  await page.viewport(320, 480);
+  const screen = await renderCombobox("ltr", "w-full", "p-0");
+
+  const { popup } = await openPopup();
+
+  expect(popup.left).toBeGreaterThanOrEqual(0);
+  expect(popup.right).toBeLessThanOrEqual(320);
+  await screen.unmount();
+});
