+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import { page } from "vitest/browser";
+import { Sonner, toast } from "../Sonner";
+import { ToastToaster, createToastManager } from "../Toast";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type NotificationSurface = {
+  fontFamily: string;
+  width: number;
+  radius: string;
+  paddingInline: string;
+  closeColor: string;
+};
+
+function readSurface(surface: HTMLElement, padded: HTMLElement, close: HTMLElement): NotificationSurface {
+  return {
+    fontFamily: getComputedStyle(surface).fontFamily,
+    width: surface.getBoundingClientRect().width,
+    radius: getComputedStyle(surface).borderTopLeftRadius,
+    paddingInline: getComputedStyle(padded).paddingInlineStart,
+    closeColor: getComputedStyle(close).color,
+  };
+}
+
+test("Sonner and Toast render the same notification surface", async () => {
+  await page.viewport(1280, 800);
+  const manager = createToastManager();
+  const screen = await render(
+    <ThemeProvider forcedTheme="dark">
+      <DensityProvider density="comfortable">
+        <ToastToaster toastManager={manager} timeout={0}>
+          <span />
+        </ToastToaster>
+        <Sonner id="notifications-parity" duration={Infinity} closeButton />
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+  manager.add({ title: "Base UI notification" });
+  toast("Sonner notification", { toasterId: "notifications-parity" });
+  await expect.element(page.getByText("Base UI notification")).toBeVisible();
+  await expect.element(page.getByText("Sonner notification")).toBeVisible();
+
+  const toastRoot = document.querySelector<HTMLElement>('[data-slot="toast"]');
+  const toastContent = toastRoot?.querySelector<HTMLElement>('[data-slot="toast-content"]');
+  const toastClose = toastRoot?.querySelector<HTMLElement>('[data-slot="toast-close"]');
+  const sonnerRoot = document.querySelector<HTMLElement>("[data-sonner-toast]");
+  const sonnerClose = sonnerRoot?.querySelector<HTMLElement>("[data-close-button]");
+  if (!toastRoot || !toastContent || !toastClose || !sonnerRoot || !sonnerClose) {
+    throw new Error("Expected both notification surfaces with close buttons");
+  }
+
+  expect(readSurface(sonnerRoot, sonnerRoot, sonnerClose)).toEqual(readSurface(toastRoot, toastContent, toastClose));
+  expect(getComputedStyle(sonnerRoot).fontFamily).toBe(getComputedStyle(document.body).fontFamily);
+  await screen.unmount();
+});
