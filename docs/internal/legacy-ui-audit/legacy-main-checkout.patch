+// Measures the narrower of a control's inline and block insets around its single-line label.
+// A bare native button is as wide as its text or as tall as its line box, so one inset rounds to zero pixels.
+export function getLabelInset(element: HTMLElement): number {
+  const range = element.ownerDocument.createRange();
+  range.selectNodeContents(element);
+  const box = element.getBoundingClientRect();
+  const lineHeight = Number.parseFloat(getComputedStyle(element).lineHeight);
+  return Math.round(Math.min(box.width - range.getBoundingClientRect().width, box.height - lineHeight) / 2);
+}
+
+// Resolves the themed ring token where the element sits, as the computed color an outline-ring utility paints.
+export function getRingColor(element: HTMLElement): string {
+  const probe = element.ownerDocument.createElement("span");
+  probe.style.color = "var(--ring)";
+  element.after(probe);
+  const color = getComputedStyle(probe).color;
+  probe.remove();
+  return color;
+}
