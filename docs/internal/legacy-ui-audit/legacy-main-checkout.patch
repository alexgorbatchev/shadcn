+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render, type RenderResult } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogMedia,
+  AlertDialogTitle,
+} from "../AlertDialog";
+import { DensityProvider } from "../DensityProvider";
+import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "../Dialog";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+function Frame({ children }: { children: ReactElement }): ReactElement {
+  return (
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density="comfortable">{children}</DensityProvider>
+    </ThemeProvider>
+  );
+}
+
+function LongBody(): ReactElement {
+  return (
+    <div className="flex flex-col gap-2">
+      {Array.from({ length: 24 }, (_, index) => (
+        <p key={index}>Release note paragraph {index + 1} describes one change in this deployment.</p>
+      ))}
+    </div>
+  );
+}
+
+function isInsideViewport(element: Element): boolean {
+  const rect = element.getBoundingClientRect();
+  return rect.top >= 0 && rect.bottom <= window.innerHeight;
+}
+
+async function revealed(element: Element): Promise<boolean> {
+  element.scrollIntoView({ block: "nearest" });
+  await new Promise(requestAnimationFrame);
+  return isInsideViewport(element);
+}
+
+test("a dialog taller than the viewport scrolls so its first and last controls stay reachable", async () => {
+  await page.viewport(390, 480);
+  const screen = await render(
+    <Frame>
+      <Dialog defaultOpen>
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>Release notes</DialogTitle>
+          </DialogHeader>
+          <LongBody />
+          <DialogFooter>
+            <button type="button">Acknowledge</button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </Frame>,
+  );
+  const close = screen.getByRole("button", { name: "Close" });
+  await expect.element(close).toBeInTheDocument();
+  const acknowledge = screen.getByRole("button", { name: "Acknowledge" }).element();
+  const popup = document.querySelector('[data-slot="dialog-content"]')!;
+  expect(popup.getBoundingClientRect().height).toBeGreaterThan(window.innerHeight);
+  await expect.poll(() => popup.contains(document.activeElement)).toBe(true);
+
+  expect(await revealed(acknowledge)).toBe(true);
+  expect(await revealed(close.element())).toBe(true);
+  await userEvent.click(close);
+  await expect.poll(() => document.querySelector('[data-slot="dialog-content"]')).toBeNull();
+  await screen.unmount();
+});
+
+test("a short dialog stays centred and a press outside it still dismisses it", async () => {
+  await page.viewport(390, 480);
+  const screen = await render(
+    <Frame>
+      <Dialog defaultOpen>
+        <DialogContent>
+          <DialogTitle>Rename project</DialogTitle>
+        </DialogContent>
+      </Dialog>
+    </Frame>,
+  );
+  await expect.element(screen.getByRole("dialog")).toBeVisible();
+  const rect = document.querySelector('[data-slot="dialog-content"]')!.getBoundingClientRect();
+  expect(Math.abs(rect.top + rect.height / 2 - window.innerHeight / 2)).toBeLessThanOrEqual(1);
+  expect(Math.abs(rect.left + rect.width / 2 - window.innerWidth / 2)).toBeLessThanOrEqual(1);
+
+  await userEvent.click(document.body, { position: { x: 4, y: 4 } });
+  await expect.poll(() => document.querySelector('[data-slot="dialog-content"]')).toBeNull();
+  await screen.unmount();
+});
+
+test("an alert dialog taller than the viewport scrolls so its title and actions stay reachable", async () => {
+  await page.viewport(390, 480);
+  const screen = await render(
+    <Frame>
+      <AlertDialog defaultOpen>
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>Delete workspace</AlertDialogTitle>
+          </AlertDialogHeader>
+          <LongBody />
+          <AlertDialogFooter>
+            <AlertDialogCancel>Keep workspace</AlertDialogCancel>
+          </AlertDialogFooter>
+        </AlertDialogContent>
+      </AlertDialog>
+    </Frame>,
+  );
+  const cancel = screen.getByRole("button", { name: "Keep workspace" });
+  await expect.element(cancel).toBeInTheDocument();
+  const title = screen.getByRole("heading", { name: "Delete workspace" }).element();
+  const popup = document.querySelector('[data-slot="alert-dialog-content"]')!;
+  expect(popup.getBoundingClientRect().height).toBeGreaterThan(window.innerHeight);
+  await expect.poll(() => popup.contains(document.activeElement)).toBe(true);
+
+  expect(await revealed(title)).toBe(true);
+  expect(await revealed(cancel.element())).toBe(true);
+  await userEvent.click(cancel);
+  await expect.poll(() => document.querySelector('[data-slot="alert-dialog-content"]')).toBeNull();
+  await screen.unmount();
+});
+
+const DENSITIES = ["comfortable", "compact"] as const;
+
+interface IMediaHeaderLayout {
+  screen: RenderResult;
+  headerRect: DOMRect;
+  headerColumnGap: number;
+  mediaRect: DOMRect;
+  titleRect: DOMRect;
+  descriptionRect: DOMRect;
+}
+
+async function renderMediaHeader(density: (typeof DENSITIES)[number]): Promise<IMediaHeaderLayout> {
+  await page.viewport(800, 600);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>
+        <AlertDialog defaultOpen>
+          <AlertDialogContent size="default">
+            <AlertDialogHeader>
+              <AlertDialogMedia>
+                <svg aria-hidden="true" viewBox="0 0 24 24" />
+              </AlertDialogMedia>
+              <AlertDialogTitle>Allow notifications?</AlertDialogTitle>
+              <AlertDialogDescription>Receive project updates.</AlertDialogDescription>
+            </AlertDialogHeader>
+          </AlertDialogContent>
+        </AlertDialog>
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+  const title = screen.getByRole("heading", { name: "Allow notifications?" });
+  await expect.element(title).toBeVisible();
+  const header = document.querySelector('[data-slot="alert-dialog-header"]')!;
+
+  return {
+    screen,
+    headerRect: header.getBoundingClientRect(),
+    headerColumnGap: Number.parseFloat(getComputedStyle(header).columnGap),
+    mediaRect: document.querySelector('[data-slot="alert-dialog-media"]')!.getBoundingClientRect(),
+    titleRect: title.element().getBoundingClientRect(),
+    descriptionRect: screen.getByText("Receive project updates.").element().getBoundingClientRect(),
+  };
+}
+
+test.each(DENSITIES)(
+  "%s alert dialog media sits one header column gap from its title and description",
+  async (density) => {
+    const { screen, headerColumnGap, mediaRect, titleRect, descriptionRect } = await renderMediaHeader(density);
+
+    expect(titleRect.left - mediaRect.right).toBeCloseTo(headerColumnGap, 1);
+    expect(descriptionRect.left).toBeCloseTo(titleRect.left, 1);
+    await screen.unmount();
+  },
+);
+
+test.each(DENSITIES)("%s alert dialog header ends at its tallest column beside the media", async (density) => {
+  const { screen, headerRect, mediaRect, descriptionRect } = await renderMediaHeader(density);
+
+  expect(headerRect.bottom).toBeCloseTo(Math.max(mediaRect.bottom, descriptionRect.bottom), 1);
+  await screen.unmount();
+});
