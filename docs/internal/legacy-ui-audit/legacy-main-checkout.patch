+const CHECKED_STATES = [false, true];
+
+// Rounds sub-pixel noise and normalises -0, so a flush edge reads as exactly 0.
+function roundInset(value: number): number {
+  return Math.round(value * 100) / 100 + 0;
+}
+
+// The thumb sits against the track's resting edge and fills its height. A gap there leaves the thumb, and every row
+// below a fractional-height switch, off the pixel grid.
+test("the thumb fills the track height and rests flush against the track edge", async () => {
+  const measured = [];
+  for (const size of SIZES) {
+    for (const isChecked of CHECKED_STATES) {
+      const screen = await render(
+        <ThemeProvider forcedTheme="light">
+          <Switch size={size} defaultChecked={isChecked} aria-label="Alerts" />
+        </ThemeProvider>,
+      );
+      const root = screen.getByRole("switch", { name: "Alerts" }).element();
+      const thumb = root.querySelector("[data-slot=switch-thumb]")!;
+      const rootRect = root.getBoundingClientRect();
+      const thumbRect = thumb.getBoundingClientRect();
+      // clientWidth and clientHeight round to whole pixels, so the track box comes from the border widths instead.
+      const border = getComputedStyle(root);
+      const track = {
+        top: rootRect.top + Number.parseFloat(border.borderTopWidth),
+        bottom: rootRect.bottom - Number.parseFloat(border.borderBottomWidth),
+        left: rootRect.left + Number.parseFloat(border.borderLeftWidth),
+        right: rootRect.right - Number.parseFloat(border.borderRightWidth),
+      };
+      const insets = {
+        top: thumbRect.top - track.top,
+        bottom: track.bottom - thumbRect.bottom,
+        // Which edge the thumb rests on is a checked-state contract the Switch stories cover; this measures the gap.
+        edge: Math.min(thumbRect.left - track.left, track.right - thumbRect.right),
+      };
+      measured.push({
+        size,
+        isChecked,
+        top: roundInset(insets.top),
+        bottom: roundInset(insets.bottom),
+        edge: roundInset(insets.edge),
+      });
+      await screen.unmount();
+    }
+  }
+
+  expect(measured).toEqual(measured.map((entry) => ({ ...entry, top: 0, bottom: 0, edge: 0 })));
+});
