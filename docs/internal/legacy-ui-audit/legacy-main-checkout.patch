+import { expect, test } from "vitest";
+import { page, type Locator } from "vitest/browser";
+import { render, type RenderResult } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import { Button } from "../Button";
+import { ButtonGroup, ButtonGroupSeparator, ButtonGroupText } from "../ButtonGroup";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] as const;
+
+type Density = (typeof DENSITIES)[number];
+
+function Frame({ density, children }: { density: Density; children: ReactElement }): ReactElement {
+  return (
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>{children}</DensityProvider>
+    </ThemeProvider>
+  );
+}
+
+interface ISeparatedGroupLayout {
+  screen: RenderResult;
+  separator: Locator;
+  separatorRect: DOMRect;
+  copyRect: DOMRect;
+  pasteRect: DOMRect;
+}
+
+async function renderSeparatedGroup(
+  density: Density,
+  orientation: "horizontal" | "vertical",
+): Promise<ISeparatedGroupLayout> {
+  await page.viewport(800, 600);
+  const screen = await render(
+    <Frame density={density}>
+      <ButtonGroup aria-label="Clipboard" orientation={orientation}>
+        <Button variant="secondary">Copy</Button>
+        <ButtonGroupSeparator />
+        <Button variant="secondary">Paste</Button>
+      </ButtonGroup>
+    </Frame>,
+  );
+  const copy = screen.getByRole("button", { name: "Copy" });
+  await expect.element(copy).toBeVisible();
+  const separator = screen.getByRole("separator");
+
+  return {
+    screen,
+    separator,
+    separatorRect: separator.element().getBoundingClientRect(),
+    copyRect: copy.element().getBoundingClientRect(),
+    pasteRect: screen.getByRole("button", { name: "Paste" }).element().getBoundingClientRect(),
+  };
+}
+
+test.each(DENSITIES)("%s vertical group separator spans the group between stacked buttons", async (density) => {
+  const { screen, separator, separatorRect, copyRect, pasteRect } = await renderSeparatedGroup(density, "vertical");
+
+  await expect.element(separator).toHaveAttribute("aria-orientation", "horizontal");
+  expect(separatorRect.height).toBeCloseTo(1, 1);
+  expect(separatorRect.width).toBeCloseTo(copyRect.width - 2, 1);
+  expect(separatorRect.top).toBeCloseTo(copyRect.bottom, 1);
+  expect(pasteRect.top).toBeCloseTo(separatorRect.bottom, 1);
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s horizontal group separator spans the button row between adjacent buttons", async (density) => {
+  const { screen, separator, separatorRect, copyRect, pasteRect } = await renderSeparatedGroup(density, "horizontal");
+
+  await expect.element(separator).toHaveAttribute("aria-orientation", "vertical");
+  expect(separatorRect.width).toBeCloseTo(1, 1);
+  expect(separatorRect.height).toBeCloseTo(copyRect.height - 2, 1);
+  expect(separatorRect.left).toBeCloseTo(copyRect.right, 1);
+  expect(pasteRect.left).toBeCloseTo(separatorRect.right, 1);
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s vertical group text is as tall as its stacked buttons", async (density) => {
+  await page.viewport(800, 600);
+  const screen = await render(
+    <Frame density={density}>
+      <ButtonGroup aria-label="Document actions" orientation="vertical">
+        <ButtonGroupText>Draft</ButtonGroupText>
+        <Button variant="outline">Save</Button>
+      </ButtonGroup>
+    </Frame>,
+  );
+  const save = screen.getByRole("button", { name: "Save" });
+  await expect.element(save).toBeVisible();
+
+  expect(screen.getByText("Draft").element().getBoundingClientRect().height).toBeCloseTo(
+    save.element().getBoundingClientRect().height,
+    1,
+  );
+  await screen.unmount();
+});
