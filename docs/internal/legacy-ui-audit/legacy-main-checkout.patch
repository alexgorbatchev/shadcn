+              <DropdownMenuSubTrigger>Share</DropdownMenuSubTrigger>
+              <DropdownMenuSubContent>
+                <DropdownMenuItem>Email link</DropdownMenuItem>
+              </DropdownMenuSubContent>
+            </DropdownMenuSub>
+          </DropdownMenuGroup>
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </ThemeProvider>,
+  );
+
+  await page.getByRole("button", { name: "Menu" }).click();
+  await page.getByRole("menuitem", { name: "Share" }).click();
+  await expect.element(page.getByRole("menuitem", { name: "Email link" })).toBeVisible();
+  const subContent = document.querySelector('[data-slot="dropdown-menu-sub-content"]')!;
+
+  expect(readRunningAnimations(subContent)).toEqual([]);
+  await screen.unmount();
+});
+
+test("sidebar collapses to icons without width, offset or label transitions under reduced motion", async () => {
+  expect(window.matchMedia("(prefers-reduced-motion: reduce)").matches).toBe(true);
