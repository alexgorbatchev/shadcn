+
+function readRunningAnimations(element: Element): Animation[] {
+  return element.getAnimations().filter((animation) => animation.playState === "running");
+}
+
+test("dropdown submenu opens without a timed animation under reduced motion", async () => {
+  expect(window.matchMedia("(prefers-reduced-motion: reduce)").matches).toBe(true);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DropdownMenu>
+        <DropdownMenuTrigger>Menu</DropdownMenuTrigger>
+        <DropdownMenuContent>
