+        <NavigationMenuList>
+          <NavigationMenuItem value="products">
+            <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+            <NavigationMenuContent>
+              <NavigationMenuLink href="#components">Components</NavigationMenuLink>
+            </NavigationMenuContent>
+          </NavigationMenuItem>
+        </NavigationMenuList>
+      </NavigationMenu>
+    ),
+  },
+  Select: {
+    slot: "select-content",
+    surface: (
+      <Select defaultOpen>
+        <SelectTrigger aria-label="Runtime">
+          <SelectValue placeholder="Select a runtime" />
+        </SelectTrigger>
+        <SelectContent>
+          <SelectItem value="bun">Bun</SelectItem>
+        </SelectContent>
+      </Select>
+    ),
+  },
+};
+
+test("floating surfaces share one corner radius", async () => {
+  const radii: Record<string, string> = {};
+  for (const [name, { slot, surface, open }] of Object.entries(floatingSurfaces)) {
+    const screen = await render(<Frame>{surface}</Frame>);
+    await open?.(screen);
+    await expect.poll(() => document.querySelector(`[data-slot="${slot}"]`)).not.toBeNull();
+    radii[name] = getComputedStyle(document.querySelector(`[data-slot="${slot}"]`)!).borderTopLeftRadius;
+    await screen.unmount();
+  }
+  expect(radii).toEqual(Object.fromEntries(Object.keys(floatingSurfaces).map((name) => [name, radii.Popover])));
+  expect(radii.Popover).not.toBe("0px");
+});
diff --git a/src/components/__tests__/FocusIndicators.test.tsx b/src/components/__tests__/FocusIndicators.test.tsx
new file mode 100644
index 0000000..4ce0cf6
--- /dev/null
+++ b/src/components/__tests__/FocusIndicators.test.tsx
@@ -0,0 +1,162 @@
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "../Accordion";
+import { Badge } from "../Badge";
+import { Field, FieldContent, FieldDescription, FieldLabel, FieldTitle } from "../Field";
+import { Input } from "../Input";
+import { InputGroup, InputGroupInput } from "../InputGroup";
+import { RadioGroup, RadioGroupItem } from "../RadioGroup";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, isSameColor, readPixel } from "./helpers";
+import type { Rgba } from "./helpers";
+import "../../../.storybook/preview.css";
+
+type Band = { start: number; end: number };
+
+type FocusCapture = {
+  band: Band;
+  frame: HTMLElement;
+  frameStart: number;
+  readFocused: (span: Band) => Rgba[];
+  wrapper: HTMLElement;
+  unmount: () => Promise<void>;
+};
+
+// Renders the surface inside a padded canvas, keyboard-focuses it, waits for its transitions to settle, and returns the
+// run of pixels that changed on the start side of the frame's vertical midline, converted to CSS pixels relative to the
+// canvas. `readFocused` reads the settled focused pixels of any span on that midline.
+async function captureFocusBand(surface: ReactElement, frameSelector: string): Promise<FocusCapture> {
+  await page.viewport(480, 240);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <div data-testid="focus-canvas" className="w-80 bg-background p-4">
+        {surface}
+      </div>
+    </ThemeProvider>,
+  );
+  const wrapper = page.getByTestId("focus-canvas").element() as HTMLElement;
+  const frame = wrapper.querySelector<HTMLElement>(frameSelector)!;
+  const before = await captureImageData(wrapper);
+  await userEvent.tab();
+  await expect.poll(() => frame.getAnimations().length).toBe(0);
+  const after = await captureImageData(wrapper);
+
+  const wrapperRect = wrapper.getBoundingClientRect();
+  const frameRect = frame.getBoundingClientRect();
+  const scale = before.width / wrapperRect.width;
+  const row = Math.round((frameRect.top - wrapperRect.top + frameRect.height / 2) * scale);
+  let start = -1;
+  let end = -1;
+  for (let x = 0; x < before.width; x += 1) {
+    const isChanged = !isSameColor(readPixel(before, x, row), readPixel(after, x, row));
+    if (isChanged && start < 0) start = x;
+    if (!isChanged && start >= 0) {
+      end = x;
+      break;
+    }
+  }
+  const readFocused = (span: Band): Rgba[] => {
+    const spanStart = Math.round(span.start * scale);
+    return Array.from({ length: Math.round(span.end * scale) - spanStart }, (_, index) =>
+      readPixel(after, spanStart + index, row),
+    );
+  };
+  return {
+    band: { start: start / scale, end: end / scale },
+    frame,
+    frameStart: frameRect.left - wrapperRect.left,
+    readFocused,
+    wrapper,
+    unmount: screen.unmount,
+  };
+}
+
+const fieldFrames: [name: string, surface: ReactElement, frame: string][] = [
+  [
+    "InputGroup",
+    <InputGroup>
+      <InputGroupInput aria-label="Search" />
+    </InputGroup>,
+    '[data-slot="input-group"]',
+  ],
+  [
+    "Field choice card",
+    <RadioGroup defaultValue="cluster" aria-label="Compute environment">
+      <FieldLabel htmlFor="focus-choice-cluster">
+        <Field orientation="horizontal">
+          <FieldContent>
+            <FieldTitle>Cluster</FieldTitle>
+            <FieldDescription>Run workloads together.</FieldDescription>
+          </FieldContent>
+          <RadioGroupItem id="focus-choice-cluster" value="cluster" />
+        </Field>
+      </FieldLabel>
+    </RadioGroup>,
+    '[data-slot="field-label"]',
+  ],
+];
+
+// Field-like frames share Input's focus indicator thickness instead of a heavier 3px halo.
+test.each(fieldFrames)("%s focus indicator matches Input thickness", async (_name, surface, frame) => {
+  const input = await captureFocusBand(<Input aria-label="Name" />, '[data-slot="input"]');
+  const inputThickness = input.band.end - input.band.start;
+  await input.unmount();
+  const field = await captureFocusBand(surface, frame);
+
+  expect(field.band.end - field.band.start).toBe(inputThickness);
+});
+
+const badgeFrames: [name: string, surface: ReactElement][] = [
+  ["default link", <Badge render={<a href="#focus-badge" />}>Docs</Badge>],
+  [
+    "link-variant link",
+    <Badge variant="link" render={<a href="#focus-badge" />}>
+      Docs
+    </Badge>,
+  ],
+  [
+    "outline button",
+    <Badge variant="outline" render={<button type="button" />}>
+      Docs
+    </Badge>,
+  ],
+];
+
+// An interactive badge shares Input's border-and-ring focus indicator. The browser's own focus ring must not paint over
+// it: it lands on the same pixels, so only the indicator's colour shows the difference. The badge is read at the same
+// offsets from its frame edge as Input's indicator, because a primary badge's border already matches the ring colour.
+test.each(badgeFrames)("%s badge focus indicator matches Input", async (_name, surface) => {
+  const input = await captureFocusBand(<Input aria-label="Name" />, '[data-slot="input"]');
+  const inputColors = input.readFocused(input.band);
+  const indicator = { start: input.band.start - input.frameStart, end: input.band.end - input.frameStart };
+  await input.unmount();
+  const badge = await captureFocusBand(surface, '[data-slot="badge"]');
+  const badgeColors = badge.readFocused({
+    start: badge.frameStart + indicator.start,
+    end: badge.frameStart + indicator.end,
+  });
+
+  expect(document.activeElement).toBe(badge.frame);
+  expect(badgeColors).toEqual(inputColors);
+});
+
+// The Accordion trigger has no inline padding, so its indicator must sit outside the text box instead of touching it.
+test("Accordion trigger focus indicator keeps clearance from its text", async () => {
+  const { band, frame, wrapper } = await captureFocusBand(
+    <Accordion>
+      <AccordionItem value="shipping">
+        <AccordionTrigger>Shipping</AccordionTrigger>
+        <AccordionContent>Ships in two days.</AccordionContent>
+      </AccordionItem>
+    </Accordion>,
+    '[data-slot="accordion-trigger"]',
+  );
+  const range = document.createRange();
+  range.selectNodeContents(frame.firstChild!);
+  const textStart = range.getBoundingClientRect().left - wrapper.getBoundingClientRect().left;
+
+  expect(document.activeElement).toBe(frame);
+  expect(textStart - band.end).toBeGreaterThan(0);
+});
