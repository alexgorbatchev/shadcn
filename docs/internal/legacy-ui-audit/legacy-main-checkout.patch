+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import type { Density } from "../../density/types";
+import { Button } from "../Button";
+import { Combobox, ComboboxChip, ComboboxChips, ComboboxChipsInput, ComboboxValue } from "../Combobox";
+import { DensityProvider } from "../DensityProvider";
+import { Input } from "../Input";
+import { InputGroup, InputGroupInput } from "../InputGroup";
+import { NativeSelect, NativeSelectOption } from "../NativeSelect";
+import { Questionnaire, QuestionnaireInput, QuestionnaireItem } from "../Questionnaire";
+import { Select, SelectTrigger, SelectValue } from "../Select";
+import { Textarea } from "../Textarea";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type Field = [name: string, surface: ReactElement, frame: string, text: string];
+
+type Signature = { fontSize: string; background: string; insetStart: string };
+
+const fields: Field[] = [
+  ["Input", <Input aria-label="Field" defaultValue="Report" />, '[data-slot="input"]', '[data-slot="input"]'],
+  [
+    "Textarea",
+    <Textarea aria-label="Field" defaultValue="Report" />,
+    '[data-slot="textarea"]',
+    '[data-slot="textarea"]',
+  ],
+  [
+    "InputGroup",
+    <InputGroup>
+      <InputGroupInput aria-label="Field" defaultValue="Report" />
+    </InputGroup>,
+    '[data-slot="input-group"]',
+    '[data-slot="input-group-control"]',
+  ],
+  [
+    "NativeSelect",
+    <NativeSelect aria-label="Field" defaultValue="report">
+      <NativeSelectOption value="report">Report</NativeSelectOption>
+    </NativeSelect>,
+    '[data-slot="native-select"]',
+    '[data-slot="native-select"]',
+  ],
+  [
+    "SelectTrigger",
+    <Select defaultValue="report" items={{ report: "Report" }}>
+      <SelectTrigger aria-label="Field">
+        <SelectValue />
+      </SelectTrigger>
+    </Select>,
+    '[data-slot="select-trigger"]',
+    '[data-slot="select-trigger"]',
+  ],
+  [
+    "ComboboxChips",
+    <Combobox multiple defaultValue={["Report"]} items={["Report"]}>
+      <ComboboxChips>
+        <ComboboxValue>
+          {(values: string[]) => values.map((value) => <ComboboxChip key={value}>{value}</ComboboxChip>)}
+        </ComboboxValue>
+        <ComboboxChipsInput aria-label="Field" />
+      </ComboboxChips>
+    </Combobox>,
+    '[data-slot="combobox-chips"]',
+    '[data-slot="combobox-chip-input"]',
+  ],
+  [
+    "QuestionnaireInput",
+    <Questionnaire>
+      <QuestionnaireItem name="code">
+        <QuestionnaireInput aria-label="Field" defaultValue="Report" />
+      </QuestionnaireItem>
+    </Questionnaire>,
+    '[data-slot="questionnaire-input"]',
+    '[data-slot="questionnaire-input"]',
+  ],
+];
+
+async function signature(density: Density, surface: ReactElement, frame: string, text: string): Promise<Signature> {
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>{surface}</DensityProvider>
+    </ThemeProvider>,
+  );
+  const frameStyle = getComputedStyle(document.querySelector(frame)!);
+  const textStyle = getComputedStyle(document.querySelector(text)!);
+  const result: Signature = {
+    fontSize: textStyle.fontSize,
+    background: frameStyle.backgroundColor,
+    insetStart: textStyle.paddingInlineStart,
+  };
+  await screen.unmount();
+  return result;
+}
+
+// Fields share Button's control text, the Input field fill, and Button's start inset in each density.
+test.each(fields)("%s matches the shared field presentation in each density", async (_name, surface, frame, text) => {
+  for (const density of ["comfortable", "compact"] satisfies Density[]) {
+    const button = await signature(density, <Button>Reference</Button>, '[data-slot="button"]', '[data-slot="button"]');
+    const input = await signature(density, fields[0]![1], fields[0]![2], fields[0]![3]);
+    const field = await signature(density, surface, frame, text);
+
+    expect({ density, fontSize: field.fontSize, background: field.background }).toEqual({
+      density,
+      fontSize: button.fontSize,
+      background: input.background,
+    });
+    if (frame === text) {
+      expect({ density, insetStart: field.insetStart }).toEqual({ density, insetStart: button.insetStart });
+    }
+  }
+});
