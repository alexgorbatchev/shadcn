@@ -0,0 +1,124 @@
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { DensityProvider } from "../DensityProvider";
+import { DirectionProvider } from "../DirectionProvider";
+import {
+  DropdownMenu,
+  DropdownMenuCheckboxItem,
+  DropdownMenuContent,
+  DropdownMenuGroup,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuTrigger,
+} from "../DropdownMenu";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type Direction = "ltr" | "rtl";
+
+function renderMenu(
+  direction: Direction,
+  density: Density,
+  triggerClassName: string,
+  wrapperClassName = "p-4",
+): ReturnType<typeof render> {
+  return render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>
+        <DirectionProvider direction={direction}>
+          <div dir={direction} className={wrapperClassName}>
+            <DropdownMenu>
+              <DropdownMenuTrigger className={triggerClassName}>Menu</DropdownMenuTrigger>
+              <DropdownMenuContent>
+                <DropdownMenuGroup>
+                  <DropdownMenuCheckboxItem defaultChecked>Notifications</DropdownMenuCheckboxItem>
+                </DropdownMenuGroup>
+                <DropdownMenuRadioGroup defaultValue="weekly">
+                  <DropdownMenuRadioItem value="weekly">Weekly summaries</DropdownMenuRadioItem>
+                </DropdownMenuRadioGroup>
+              </DropdownMenuContent>
+            </DropdownMenu>
+          </div>
+        </DirectionProvider>
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+}
+
+function measureText(element: Element): DOMRect {
+  const range = document.createRange();
+  range.selectNodeContents(element);
+  const indicator = element.querySelector('[data-slot$="-indicator"]');
+  if (indicator) {
+    range.setStartAfter(indicator);
+  }
+  return range.getBoundingClientRect();
+}
+
+async function openMenu(): Promise<HTMLElement> {
+  await userEvent.click(page.getByRole("button", { name: "Menu" }));
+  const item = await page.getByRole("menuitemcheckbox", { name: "Notifications" }).findElement();
+  const popup = item.closest<HTMLElement>('[data-slot="dropdown-menu-content"]');
+  if (!popup) {
+    throw new Error("Expected the checkbox item inside the dropdown popup");
+  }
+  await expect.poll(() => popup.getAnimations().length).toBe(0);
+  return popup;
+}
+
+test.each([
+  ["ltr", "compact", "p-4"],
+  ["ltr", "comfortable", "p-4"],
+  ["rtl", "compact", "p-4"],
+  ["ltr", "comfortable", "flex justify-end p-4"],
+] satisfies [Direction, Density, string][])(
+  "checkable item labels stay clear of their indicators under a narrow trigger (%s, %s, %s)",
+  async (direction, density, wrapperClassName) => {
+    await page.viewport(320, 480);
+    const screen = await renderMenu(direction, density, "w-16", wrapperClassName);
+
+    await openMenu();
+
+    for (const [role, name] of [
+      ["menuitemcheckbox", "Notifications"],
+      ["menuitemradio", "Weekly summaries"],
+    ] as const) {
+      const item = page.getByRole(role, { name }).element();
+      const indicator = item.querySelector('[data-slot$="-indicator"]')!.getBoundingClientRect();
+      const label = measureText(item);
+      const lines = Math.round(label.height / Number.parseFloat(getComputedStyle(item).lineHeight));
+
+      expect(lines).toBe(1);
+      if (direction === "ltr") {
+        expect(label.right).toBeLessThanOrEqual(indicator.left);
+      } else {
+        expect(label.left).toBeGreaterThanOrEqual(indicator.right);
+      }
+    }
+    await screen.unmount();
+  },
+);
+
+test("the dropdown popup is never narrower than a wide trigger", async () => {
+  await page.viewport(800, 480);
+  const screen = await renderMenu("ltr", "comfortable", "w-80");
+
+  const popup = await openMenu();
+  const trigger = page.getByRole("button", { name: "Menu" }).element().getBoundingClientRect();
+
+  expect(popup.getBoundingClientRect().width).toBeCloseTo(trigger.width, 0);
+  await screen.unmount();
+});
+
+test("the dropdown popup stays inside a narrow viewport", async () => {
+  await page.viewport(320, 480);
+  const screen = await renderMenu("ltr", "comfortable", "w-full", "p-0");
+
+  const popup = (await openMenu()).getBoundingClientRect();
+
+  expect(popup.left).toBeGreaterThanOrEqual(0);
+  expect(popup.right).toBeLessThanOrEqual(320);
+  await screen.unmount();
+});
