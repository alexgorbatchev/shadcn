+++ b/.agents/skills/ask-user/SKILL.md
@@ -0,0 +1,54 @@
+---
+name: ask-user
+description: Use when asking the user to choose between visual design options for components, including colors, states, focus indicators, weights, spacing, or layouts whose answer depends on seeing them rendered.
+author: alexgorbatchev
+metadata:
+  created_on: 2026-10-15 10:11
+  last_modified: 2026-10-15 10:11
+  status: current
+---
+
+Ask visual questions through a temporary Storybook decision story that renders every option and copies the answers as plain text for the user to paste back.
+
+## Scope
+
+- Apply this skill only when the user must see rendered output to answer. Ask text, naming, API, scope, or policy questions with the regular question tool or in chat.
+- Leave component source unchanged until the answers arrive. The story previews options by merging class names onto the current component.
+
+## Build the story
+
+1. Gather facts for each question before writing options: the current computed style, the upstream shadcn source, and any precedent in this repository (for example `src/components/Button.tsx`). Every option needs one of these as its source.
+2. Copy [assets/DecisionStory.stories.tsx](assets/DecisionStory.stories.tsx) to `src/components/stories/<Component>DesignDecision.stories.tsx`. Replace `DECISION_TITLE`, `QuestionId`, `QUESTIONS`, `DecisionSubject`, the `meta.title` suffix, and the play function. Keep `meta.title` under `shadcn-alexgorbatchev/decisions/`.
+3. Write options as follows:
+   - Set `className` to the exact classes that would ship, or `""` for the current styling. Implement the chosen option from these classes later.
+   - Label the current behavior `(current)` and name the source of every other option in its label, such as `(upstream)` or `(Button precedent)`.
+   - State the concrete change in `description`, such as the utility classes or the measured value change.
+   - Use `requires` when a question only applies after a specific answer to another question.
+4. Make `DecisionSubject` render every state and variant the decision affects. Give each element a unique accessible name within one subject.
+5. Keep the two preview surfaces the template provides:
+   - Each option renders its own sample next to its radio button, using the current answers plus that option. The user compares options side by side without selecting each one.
+   - The combined preview is sticky, so it stays in view while the user answers the last question. Questions that scroll away from a single top preview cannot be judged.
+6. For options that differ only on hover, focus, press, or motion, tell the user in the question `description` to hover, Tab, or press the samples. Static samples do not show those states.
+
+## Verify before handing off
+
+1. Screenshot every option sample with Playwright from a script in `.tmp/`, then view the screenshots. When two options look identical at 100% zoom, merge or remove the question. If the difference still matters, put the measured value change in `description`, for example `font-weight 500 → 600, barely visible in this font`.
+2. Scroll to the last question at 1280px and 320px widths and confirm that the combined preview is still visible.
+3. Write the play function to cover:
+   - a non-current option sample computing a different style from the current one
+   - `requires` gating
+   - the exact copied answer text
+4. Run the story with `.storybook/vitest.config.ts`, `.storybook/vitest.narrow.config.ts` and `.storybook/vitest.contrast.config.ts`, using the story file as the CLI filter.
+
+## Hand off
+
+- Give the user the direct story URL, in story view rather than Docs, from the running preview: `/?path=/story/shadcn-alexgorbatchev-decisions-<title-slug>--questionnaire`.
+- Also tell them where it sits in the sidebar: the `decisions` group, collapsed at the bottom.
+- Tell them to paste the copied answers back. The read-only "Answers to paste" field is the fallback where the clipboard API is unavailable, such as plain HTTP.
+- Stop and wait for the pasted answers.
+
+## Apply the answers
+
+1. Implement the chosen options' `className` values in the component, following the repository's red/green regression workflow.
+2. Record the decision and its option slugs where the question originated, such as the review entry.
+3. Delete the decision story.
diff --git a/.agents/skills/ask-user/assets/DecisionStory.stories.tsx b/.agents/skills/ask-user/assets/DecisionStory.stories.tsx
new file mode 100644
index 0000000..2b79d8a
--- /dev/null
+++ b/.agents/skills/ask-user/assets/DecisionStory.stories.tsx
@@ -0,0 +1,274 @@
+import type { ReactElement, ReactNode } from "react";
+import { useId, useState } from "react";
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, userEvent, waitFor, within } from "storybook/test";
+import { useCopyToClipboard } from "usehooks-ts";
+import { CopyIcon } from "lucide-react";
+import { Button } from "../Button";
+import { Field, FieldContent, FieldDescription, FieldGroup, FieldLabel, FieldLegend, FieldSet } from "../Field";
+import { RadioGroup, RadioGroupItem } from "../RadioGroup";
+import { Textarea } from "../Textarea";
+import { Toggle } from "../Toggle";
+import { cn } from "../../utils/cn";
+
+// First line of the copied answers; name the review item and the decision.
+const DECISION_TITLE = "L00 Toggle pressed-state decision";
+
+type QuestionId = "pressedFill" | "pressedHover";
+type Answers = Partial<Record<QuestionId, string>>;
+
+interface IDecisionOption {
+  value: string;
+  label: string;
+  description: string;
+  // Classes merged onto the subject when the option is selected; empty keeps the current styling.
+  className: string;
+}
+
+interface IDecisionQuestion {
+  id: QuestionId;
+  title: string;
+  description: string;
+  options: IDecisionOption[];
+  // The question only applies when another question has the given answer.
+  requires?: { id: QuestionId; value: string };
+}
+
+const QUESTIONS: IDecisionQuestion[] = [
+  {
+    id: "pressedFill",
+    title: "Pressed fill",
+    description: "Background of a pressed toggle.",
+    options: [
+      { value: "muted", label: "Muted (current)", description: "Pressed toggles keep bg-muted.", className: "" },
+      {
+        value: "primary",
+        label: "Primary",
+        description: "Pressed toggles use the primary surface.",
+        className: "aria-pressed:bg-primary aria-pressed:text-primary-foreground",
+      },
+    ],
+  },
+  {
+    id: "pressedHover",
+    title: "Pressed hover",
+    description: "Background while hovering a pressed toggle. Hover each sample to compare.",
+    requires: { id: "pressedFill", value: "primary" },
+    options: [
+      {
+        value: "dim",
+        label: "Dim",
+        description: "aria-pressed:hover:bg-primary/80.",
+        className: "aria-pressed:hover:bg-primary/80",
+      },
+      {
+        value: "unchanged",
+        label: "Unchanged",
+        description: "The primary fill stays while hovered.",
+        className: "aria-pressed:hover:bg-primary",
+      },
+    ],
+  },
+];
+
+// Renders every state the decision affects; each sample needs a unique accessible name inside its group.
+function DecisionSubject({ className }: { className: string }): ReactElement {
+  return (
+    <div className="flex flex-wrap items-center gap-2">
+      <Toggle aria-label="Unpressed" className={className}>
+        Bold
+      </Toggle>
+      <Toggle aria-label="Pressed" defaultPressed className={className}>
+        Italic
+      </Toggle>
+    </div>
+  );
+}
+
+function isQuestionAvailable(question: IDecisionQuestion, answers: Answers): boolean {
+  return question.requires === undefined || answers[question.requires.id] === question.requires.value;
+}
+
+function findOption(question: IDecisionQuestion, value: unknown): IDecisionOption | undefined {
+  return question.options.find((option) => option.value === value);
+}
+
+function selectedClassName(answers: Answers): string {
+  return cn(
+    QUESTIONS.filter((question) => isQuestionAvailable(question, answers)).map(
+      (question) => findOption(question, answers[question.id])?.className,
+    ),
+  );
+}
+
+function formatAnswer(question: IDecisionQuestion, answers: Answers): string {
+  if (!isQuestionAvailable(question, answers)) {
+    const required = QUESTIONS.find((candidate) => candidate.id === question.requires?.id);
+    const requiredOption = required && findOption(required, question.requires?.value);
+    return `(not applicable: requires ${required?.title} = ${requiredOption?.label})`;
+  }
+  const option = findOption(question, answers[question.id]);
+  return option ? `${option.label} [${option.value}]` : "(no answer)";
+}
+
+function formatAnswers(answers: Answers, notes: string): string {
+  return [
+    DECISION_TITLE,
+    ...QUESTIONS.map((question, index) => `${index + 1}. ${question.title}: ${formatAnswer(question, answers)}`),
+    `Notes: ${notes.trim() || "(none)"}`,
+  ].join("\n");
+}
+
+function OptionSample({ label, children }: { label: string; children: ReactNode }): ReactElement {
+  return (
+    <div role="group" aria-label={label} className="pt-2">
+      {children}
+    </div>
+  );
+}
+
+function DecisionQuestion({
+  question,
+  answers,
+  onAnswer,
+}: {
+  question: IDecisionQuestion;
+  answers: Answers;
+  onAnswer: (id: QuestionId, value: string | undefined) => void;
+}): ReactElement {
+  const id = useId();
+  const isAvailable = isQuestionAvailable(question, answers);
+  return (
+    <FieldSet>
+      <FieldLegend variant="label">{question.title}</FieldLegend>
+      <FieldDescription id={id + "-help"}>{question.description}</FieldDescription>
+      <RadioGroup
+        aria-label={question.title}
+        aria-describedby={id + "-help"}
+        disabled={!isAvailable}
+        value={isAvailable ? (answers[question.id] ?? null) : null}
+        onValueChange={(value) => onAnswer(question.id, findOption(question, value)?.value)}
+      >
+        {question.options.map((option) => (
+          <Field key={option.value} orientation="horizontal" data-disabled={isAvailable ? undefined : true}>
+            <RadioGroupItem id={`${id}-${option.value}`} value={option.value} />
+            <FieldContent>
+              <FieldLabel htmlFor={`${id}-${option.value}`}>{option.label}</FieldLabel>
+              <FieldDescription>{option.description}</FieldDescription>
+              <OptionSample label={`${question.title}: ${option.label} sample`}>
+                <DecisionSubject className={selectedClassName({ ...answers, [question.id]: option.value })} />
+              </OptionSample>
+            </FieldContent>
+          </Field>
+        ))}
+      </RadioGroup>
+    </FieldSet>
+  );
+}
+
+function DecisionQuestionnaire(): ReactElement {
+  const id = useId();
+  const [answers, setAnswers] = useState<Answers>({});
+  const [notes, setNotes] = useState("");
+  const [copyResult, setCopyResult] = useState("");
+  const [, copy] = useCopyToClipboard();
+  const summary = formatAnswers(answers, notes);
+
+  return (
+    <div className="flex w-full flex-col gap-8">
+      {/* Sticky so the combined result stays visible while later questions are answered; z-10 keeps the
+          positioned radio controls that scroll underneath from painting over it. */}
+      <section aria-label="Combined preview" className="sticky top-0 z-10 border-b border-border bg-background py-4">
+        <FieldSet>
+          <FieldLegend variant="label">Combined preview</FieldLegend>
+          <FieldDescription>All selected answers together. Hover, press and Tab through it.</FieldDescription>
+          <DecisionSubject className={selectedClassName(answers)} />
+        </FieldSet>
+      </section>
+      <FieldGroup>
+        {QUESTIONS.map((question) => (
+          <DecisionQuestion
+            key={question.id}
+            question={question}
+            answers={answers}
+            onAnswer={(questionId, value) => setAnswers((current) => ({ ...current, [questionId]: value }))}
+          />
+        ))}
+        <Field>
+          <FieldLabel htmlFor={id + "-notes"}>Notes</FieldLabel>
+          <Textarea id={id + "-notes"} value={notes} onChange={(event) => setNotes(event.target.value)} />
+        </Field>
+        <Field>
+          <FieldLabel htmlFor={id + "-summary"}>Answers to paste</FieldLabel>
+          <FieldDescription id={id + "-summary-help"}>
+            Select this text manually when the clipboard is unavailable, for example over plain HTTP.
+          </FieldDescription>
+          <Textarea id={id + "-summary"} aria-describedby={id + "-summary-help"} readOnly value={summary} />
+        </Field>
+        <Field orientation="horizontal">
+          <Button
+            type="button"
+            onClick={async () =>
+              setCopyResult(
+                (await copy(summary)) ? "Answers copied" : "Clipboard unavailable. Select the answers text instead.",
+              )
+            }
+          >
+            <CopyIcon data-icon="inline-start" />
+            Copy answers
+          </Button>
+          <output aria-label="Copy result" className="text-sm text-muted-foreground">
+            {copyResult}
+          </output>
+        </Field>
+      </FieldGroup>
+    </div>
+  );
+}
+
+const meta: Meta = {
+  title: "shadcn-alexgorbatchev/decisions/Toggle pressed state",
+  tags: ["test"],
+};
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Questionnaire: Story = {
+  render: () => <DecisionQuestionnaire />,
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const combined = within(canvas.getByRole("region", { name: "Combined preview" }));
+    const pressed = combined.getByRole("button", { name: "Pressed" });
+    const currentBackground = getComputedStyle(pressed).backgroundColor;
+    const primarySample = within(canvas.getByRole("group", { name: "Pressed fill: Primary sample" }));
+    await expect(getComputedStyle(primarySample.getByRole("button", { name: "Pressed" })).backgroundColor).not.toBe(
+      currentBackground,
+    );
+
+    const pressedHover = canvas.getByRole("radiogroup", { name: "Pressed hover" });
+    await expect(pressedHover).toHaveAttribute("aria-disabled", "true");
+    await userEvent.click(canvas.getByRole("radio", { name: "Primary" }));
+    await waitFor(() => expect(getComputedStyle(pressed).backgroundColor).not.toBe(currentBackground));
+    await expect(pressedHover).not.toHaveAttribute("aria-disabled");
+
+    await userEvent.click(canvas.getByRole("radio", { name: "Dim" }));
+    await userEvent.type(canvas.getByRole("textbox", { name: "Notes" }), "Ship it");
+    await userEvent.click(canvas.getByRole("button", { name: "Copy answers" }));
+    await expect(canvas.getByRole("status", { name: "Copy result" })).toHaveTextContent("Answers copied");
+    await expect(await navigator.clipboard.readText()).toBe(
+      [DECISION_TITLE, "1. Pressed fill: Primary [primary]", "2. Pressed hover: Dim [dim]", "Notes: Ship it"].join(
+        "\n",
+      ),
+    );
+
+    await userEvent.click(canvas.getByRole("radio", { name: "Muted (current)" }));
+    await expect(canvas.getByRole("textbox", { name: "Answers to paste" })).toHaveValue(
+      [
+        DECISION_TITLE,
+        "1. Pressed fill: Muted (current) [muted]",
+        "2. Pressed hover: (not applicable: requires Pressed fill = Primary)",
+        "Notes: Ship it",
+      ].join("\n"),
+    );
+  },
+};
