+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { BreadcrumbEllipsis, BreadcrumbItem, BreadcrumbList, Breadcrumb } from "../Breadcrumb";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import { DropdownMenu, DropdownMenuTrigger } from "../DropdownMenu";
+import { ThemeProvider } from "../ThemeProvider";
+import { measureOverflow } from "./helpers";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const TRIGGER_SIZES = ["xs", "icon-xs", "icon-sm"] as const;
+
+// A collapsed-ancestors trigger keeps the ellipsis inside the button at every density and trigger size.
+test("an ellipsis inside a menu trigger stays within the button", async () => {
+  for (const density of DENSITIES) {
+    for (const size of TRIGGER_SIZES) {
+      const screen = await render(
+        <ThemeProvider forcedTheme="light">
+          <DensityProvider density={density}>
+            <Breadcrumb>
+              <BreadcrumbList>
+                <BreadcrumbItem>
+                  <DropdownMenu>
+                    <DropdownMenuTrigger render={<Button variant="ghost" size={size} aria-label="Show ancestors" />}>
+                      <BreadcrumbEllipsis />
+                    </DropdownMenuTrigger>
+                  </DropdownMenu>
+                </BreadcrumbItem>
+              </BreadcrumbList>
+            </Breadcrumb>
+          </DensityProvider>
+        </ThemeProvider>,
+      );
+      const trigger = document.querySelector("[aria-label='Show ancestors']")!;
+      const ellipsis = trigger.querySelector("[data-slot=breadcrumb-ellipsis]")!;
+
+      expect({
+        density,
+        size,
+        overflow: measureOverflow(ellipsis, trigger),
+        scrollOverflow: trigger.scrollHeight - trigger.clientHeight,
+      }).toEqual({ density, size, overflow: 0, scrollOverflow: 0 });
+      await screen.unmount();
+    }
+  }
+});
diff --git a/src/components/__tests__/Bubble.test.tsx b/src/components/__tests__/Bubble.test.tsx
new file mode 100644
index 0000000..ee548fc
--- /dev/null
+++ b/src/components/__tests__/Bubble.test.tsx
@@ -0,0 +1,132 @@
+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { Bubble, BubbleContent, BubbleGroup, BubbleReactions } from "../Bubble";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, isSameColor, readPixel } from "./helpers";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const DIRECTIONS = ["ltr", "rtl"] as const;
+
+function countInkPixels(image: ImageData): number {
+  const background = readPixel(image, 0, 0);
+  let count = 0;
+  for (let y = 0; y < image.height; y += 1) {
+    for (let x = 0; x < image.width; x += 1) {
+      if (!isSameColor(readPixel(image, x, y), background)) {
+        count += 1;
+      }
+    }
+  }
+  return count;
+}
+
+function OrderedList() {
+  return (
+    <div className="typeset">
+      <ol type="a">
+        <li>Read</li>
+        <li>Validate</li>
+      </ol>
+    </div>
+  );
+}
+
+// Typeset hangs list markers into the inline-start gutter; a ghost bubble has no padding to hold them, so it must not clip
+// them. The reference renders the same list at the same type size outside any bubble.
+test("a ghost bubble paints typeset list markers in full", async () => {
+  for (const density of DENSITIES) {
+    for (const dir of DIRECTIONS) {
+      const screen = await render(
+        <ThemeProvider forcedTheme="light">
+          <DensityProvider density={density}>
+            <div dir={dir} className="flex flex-col gap-8 bg-background p-8" style={{ width: 320 }}>
+              <div data-testid="bubble-frame" className="p-8">
+                <Bubble variant="ghost" className="w-full">
+                  <BubbleContent className="w-full">
+                    <OrderedList />
+                  </BubbleContent>
+                </Bubble>
+              </div>
+              <div data-testid="reference-frame" className="p-8">
+                <div className="text-sm leading-relaxed">
+                  <OrderedList />
+                </div>
+              </div>
+            </div>
+          </DensityProvider>
+        </ThemeProvider>,
+      );
+      const bubbleInk = countInkPixels(await captureImageData(screen.getByTestId("bubble-frame").element()));
+      const referenceInk = countInkPixels(await captureImageData(screen.getByTestId("reference-frame").element()));
+
+      expect({ density, dir, ink: bubbleInk }).toEqual({ density, dir, ink: referenceInk });
+      await screen.unmount();
+    }
+  }
+});
+
+type Edges = { previous: DOMRect; content: DOMRect; reactions: DOMRect; next: DOMRect };
+
+const REACTION_SIDES = [
+  {
+    side: "top",
+    clearance: ({ previous, reactions }: Edges) => reactions.top - previous.bottom,
+    overlap: ({ content, reactions }: Edges) => reactions.bottom - content.top,
+    padding: "paddingTop",
+  },
+  {
+    side: "bottom",
+    clearance: ({ reactions, next }: Edges) => next.top - reactions.bottom,
+    overlap: ({ content, reactions }: Edges) => content.bottom - reactions.top,
+    padding: "paddingBottom",
+  },
+] as const;
+
+// Reactions straddle the content edge by exactly the content's padding, so they never cover its text in any density,
+// and the part hanging outside the content must occupy layout space so a default BubbleGroup keeps its gap between the
+// reactions and the neighbouring bubble.
+test("bubble reactions keep the group gap to neighbouring bubbles", async () => {
+  for (const density of DENSITIES) {
+    for (const { side, clearance, overlap, padding } of REACTION_SIDES) {
+      const screen = await render(
+        <ThemeProvider forcedTheme="light">
+          <DensityProvider density={density}>
+            <BubbleGroup data-testid="group" className="w-80">
+              <Bubble>
+                <BubbleContent data-testid="previous">Previous reply</BubbleContent>
+              </Bubble>
+              <Bubble>
+                <BubbleContent data-testid="content">The review is ready.</BubbleContent>
+                <BubbleReactions data-testid="reactions" side={side}>
+                  <Button size="xs" variant="secondary">
+                    Like review
+                  </Button>
+                </BubbleReactions>
+              </Bubble>
+              <Bubble>
+                <BubbleContent data-testid="next">Next reply</BubbleContent>
+              </Bubble>
+            </BubbleGroup>
+          </DensityProvider>
+        </ThemeProvider>,
+      );
+      const rect = (testId: string) => screen.getByTestId(testId).element().getBoundingClientRect();
+      const edges: Edges = {
+        previous: rect("previous"),
+        content: rect("content"),
+        reactions: rect("reactions"),
+        next: rect("next"),
+      };
+      const groupGap = Number.parseFloat(getComputedStyle(screen.getByTestId("group").element()).rowGap);
+
+      expect({ density, side, clearance: clearance(edges) }).toEqual({ density, side, clearance: groupGap });
+      const contentPadding = Number.parseFloat(getComputedStyle(screen.getByTestId("content").element())[padding]);
+      expect({ density, side, overlap: overlap(edges) }).toEqual({ density, side, overlap: contentPadding });
+      await screen.unmount();
+    }
+  }
+});
diff --git a/src/components/__tests__/Button.test.tsx b/src/components/__tests__/Button.test.tsx
new file mode 100644
index 0000000..52b2d72
--- /dev/null
+++ b/src/components/__tests__/Button.test.tsx
@@ -0,0 +1,152 @@
+import { BookmarkIcon } from "lucide-react";
+import type { ReactNode } from "react";
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, isSameColor, readPixel } from "./helpers";
+import type { Rgba } from "./helpers";
+import "../../../.storybook/preview.css";
+
+type Theme = "light" | "dark";
+type ButtonVariant = "default" | "outline" | "secondary" | "ghost" | "destructive" | "success" | "warning" | "link";
+
+const VARIANTS: ButtonVariant[] = [
+  "default",
+  "outline",
+  "secondary",
+  "ghost",
+  "destructive",
+  "success",
+  "warning",
+  "link",
+];
+
+async function readScanline(wrapper: HTMLElement, button: HTMLElement): Promise<Rgba[]> {
+  const image = await captureImageData(wrapper);
+  const wrapperRect = wrapper.getBoundingClientRect();
+  const buttonRect = button.getBoundingClientRect();
+  const scale = image.width / wrapperRect.width;
+  const row = Math.round((buttonRect.top - wrapperRect.top + buttonRect.height / 2) * scale);
+  // Stops just inside the fill, before the label, so only the edge treatment is sampled.
+  const end = Math.round((buttonRect.left - wrapperRect.left + 3) * scale);
+
+  return Array.from({ length: end + 1 }, (_, index) => readPixel(image, index, row));
+}
+
+// Focus is visible at the edge when it changes pixels outside the fill: either in a colour other than the fill, or
+// separated from the fill by a band of another colour. A ring painted in the fill colour directly against the fill only
+// enlarges the fill.
+function showsFocusOutsideFill(resting: Rgba[], focused: Rgba[]): boolean {
+  const fill = focused.at(-1)!;
+  let fillStart = focused.length - 1;
+  while (fillStart > 0 && isSameColor(focused[fillStart - 1]!, fill)) {
+    fillStart -= 1;
+  }
+  return focused.slice(0, fillStart).some((pixel, index) => !isSameColor(pixel, resting[index]!));
+}
+
+const THEMES: Theme[] = ["light", "dark"];
+const CASES: [ButtonVariant, Theme][] = VARIANTS.flatMap((variant) =>
+  THEMES.map((theme): [ButtonVariant, Theme] => [variant, theme]),
+);
+
+test.each(CASES)(
+  "keyboard focus on the %s button shows an indicator outside its fill in %s theme",
+  async (variant, theme) => {
+    await page.viewport(480, 240);
+    const screen = await render(
+      <ThemeProvider forcedTheme={theme}>
+        <DensityProvider density="comfortable">
+          <div data-testid="surface" className="inline-block bg-background p-4">
+            <Button variant={variant}>Save</Button>
+          </div>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const wrapper = screen.getByTestId("surface").element() as HTMLElement;
+    const button = screen.getByRole("button", { name: "Save" }).element() as HTMLElement;
+
+    const resting = await readScanline(wrapper, button);
+    expect(showsFocusOutsideFill(resting, resting)).toBe(false);
+
+    await userEvent.tab();
+    expect(document.activeElement).toBe(button);
+    await expect.poll(async () => showsFocusOutsideFill(resting, await readScanline(wrapper, button))).toBe(true);
+    await screen.unmount();
+  },
+);
+
+type LabelSize = "xs" | "sm" | "default" | "lg";
+type IconSize = "icon-xs" | "icon-sm" | "icon" | "icon-lg";
+
+const DENSITIES: Density[] = ["comfortable", "compact"];
+const LABEL_SIZES: LabelSize[] = ["xs", "sm", "default", "lg"];
+const LABEL_CONTENTS: Record<string, ReactNode> = {
+  "label only": "Save changes",
+  "leading icon": [<BookmarkIcon key="icon" data-icon="inline-start" />, "Save changes"],
+  "trailing icon": ["Save changes", <BookmarkIcon key="icon" data-icon="inline-end" />],
+};
+const ICON_SIZE_LABEL_SIZES: [IconSize, LabelSize][] = [
+  ["icon-xs", "xs"],
+  ["icon-sm", "sm"],
+  ["icon", "default"],
+  ["icon-lg", "lg"],
+];
+
+async function measureButton(density: Density, size: LabelSize | IconSize, content: ReactNode) {
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>
+        <Button size={size} aria-label="Save changes">
+          {content}
+        </Button>
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+  const button = screen.getByRole("button", { name: "Save changes" }).element();
+  const measured = {
+    width: button.getBoundingClientRect().width,
+    glyph: button.querySelector("svg")?.getBoundingClientRect().width,
+  };
+  await screen.unmount();
+  return measured;
+}
+
+// A smaller size step that renders wider than a larger one breaks the size scale consumers pick from.
+test("labelled buttons never narrow as the size steps up at any density", async () => {
+  const measured = [];
+  for (const density of DENSITIES) {
+    for (const [content, children] of Object.entries(LABEL_CONTENTS)) {
+      const widths = [];
+      for (const size of LABEL_SIZES) {
+        widths.push((await measureButton(density, size, children)).width);
+      }
+      measured.push({ density, content, sizes: LABEL_SIZES, widths });
+    }
+  }
+
+  expect(measured).toEqual(measured.map((entry) => ({ ...entry, widths: entry.widths.toSorted((a, b) => a - b) })));
+});
+
+// An icon-only button stands in for its labelled size in toolbars, so both draw the same glyph.
+test("icon-only buttons draw the glyph of their labelled size at every density", async () => {
+  const measured = [];
+  const expected = [];
+  for (const density of DENSITIES) {
+    for (const [iconSize, labelSize] of ICON_SIZE_LABEL_SIZES) {
+      const icon = <BookmarkIcon aria-hidden />;
+      measured.push({ density, iconSize, glyph: (await measureButton(density, iconSize, icon)).glyph });
+      expected.push({
+        density,
+        iconSize,
+        glyph: (await measureButton(density, labelSize, LABEL_CONTENTS["leading icon"])).glyph,
+      });
+    }
+  }
+
+  expect(measured).toEqual(expected);
+});
