+import { expect, test } from "vitest";
+import { page } from "vitest/browser";
+import { render, type RenderResult } from "vitest-browser-react";
+import { DensityProvider } from "../DensityProvider";
+import { DirectionProvider } from "../DirectionProvider";
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "../Tabs";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] as const;
+
+interface ILineTabsLayout {
+  screen: RenderResult;
+  listRect: DOMRect;
+  triggerRect: DOMRect;
+  triggerStyle: CSSStyleDeclaration;
+  indicatorStyle: CSSStyleDeclaration;
+}
+
+async function renderLineTabs(
+  density: (typeof DENSITIES)[number],
+  orientation: "horizontal" | "vertical",
+  direction: "ltr" | "rtl",
+): Promise<ILineTabsLayout> {
+  await page.viewport(800, 600);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>
+        <DirectionProvider direction={direction}>
+          <Tabs defaultValue="overview" orientation={orientation} dir={direction}>
+            <TabsList variant="line" aria-label="Project sections">
+              <TabsTrigger value="overview">Overview</TabsTrigger>
+              <TabsTrigger value="settings">Settings</TabsTrigger>
+            </TabsList>
+            <TabsContent value="overview">Project overview.</TabsContent>
+            <TabsContent value="settings">Project settings.</TabsContent>
+          </Tabs>
+        </DirectionProvider>
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+  const trigger = screen.getByRole("tab", { name: "Overview" });
+  await expect.element(trigger).toHaveAttribute("aria-selected", "true");
+
+  return {
+    screen,
+    listRect: screen.getByRole("tablist", { name: "Project sections" }).element().getBoundingClientRect(),
+    triggerRect: trigger.element().getBoundingClientRect(),
+    triggerStyle: getComputedStyle(trigger.element()),
+    indicatorStyle: getComputedStyle(trigger.element(), "::after"),
+  };
+}
+
+test.each(DENSITIES)("%s horizontal line indicator sits on the inside of the list bottom edge", async (density) => {
+  const { screen, listRect, triggerRect, triggerStyle, indicatorStyle } = await renderLineTabs(
+    density,
+    "horizontal",
+    "ltr",
+  );
+  const indicatorBottom =
+    triggerRect.bottom - Number.parseFloat(triggerStyle.borderBottomWidth) - Number.parseFloat(indicatorStyle.bottom);
+
+  expect(indicatorBottom).toBeCloseTo(listRect.bottom, 1);
+  expect(indicatorBottom - Number.parseFloat(indicatorStyle.height)).toBeGreaterThan(triggerRect.top);
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s vertical line indicator sits on the inside of the list end edge", async (density) => {
+  const { screen, listRect, triggerRect, triggerStyle, indicatorStyle } = await renderLineTabs(
+    density,
+    "vertical",
+    "ltr",
+  );
+  const indicatorRight =
+    triggerRect.right - Number.parseFloat(triggerStyle.borderRightWidth) - Number.parseFloat(indicatorStyle.right);
+
+  expect(indicatorRight).toBeCloseTo(listRect.right, 1);
+  await screen.unmount();
+});
+
+test.each(DENSITIES)(
+  "%s right-to-left vertical line indicator sits on the inside of the list end edge",
+  async (density) => {
+    const { screen, listRect, triggerRect, triggerStyle, indicatorStyle } = await renderLineTabs(
+      density,
+      "vertical",
+      "rtl",
+    );
+    const indicatorLeft =
+      triggerRect.left + Number.parseFloat(triggerStyle.borderLeftWidth) + Number.parseFloat(indicatorStyle.left);
+
+    expect(indicatorLeft).toBeCloseTo(listRect.left, 1);
+    await screen.unmount();
+  },
+);
