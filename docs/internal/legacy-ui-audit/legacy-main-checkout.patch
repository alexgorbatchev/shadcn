+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import type { Density } from "../../density/types";
+import { Checkbox } from "../Checkbox";
+import { DensityProvider } from "../DensityProvider";
+import { Field, FieldGroup, FieldLabel } from "../Field";
+import { RadioGroup, RadioGroupItem } from "../RadioGroup";
+import { Switch } from "../Switch";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type StackedControl = [
+  name: string,
+  slot: string,
+  renderControl: (id: string) => ReactElement,
+  renderGroup: (field: ReactElement) => ReactElement,
+];
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const STACKED_ORIENTATIONS = ["vertical", "responsive"] as const;
+
+const controls: StackedControl[] = [
+  ["Checkbox", "checkbox", (id) => <Checkbox id={id} />, (field) => field],
+  ["Switch", "switch", (id) => <Switch id={id} />, (field) => field],
+  [
+    "RadioGroupItem",
+    "radio-group-item",
+    (id) => <RadioGroupItem id={id} value={id} />,
+    (field) => (
+      <RadioGroup defaultValue="stacked" aria-label="Frequency">
+        {field}
+      </RadioGroup>
+    ),
+  ],
+];
+
+// Stacked fields stretch text and inputs to the row, but a toggle control keeps its intrinsic size.
+test.each(controls)(
+  "%s keeps its intrinsic width as a stacked field control",
+  async (_name, slot, renderControl, renderGroup) => {
+    for (const density of DENSITIES) {
+      for (const orientation of STACKED_ORIENTATIONS) {
+        const screen = await render(
+          <ThemeProvider forcedTheme="light">
+            <DensityProvider density={density}>
+              <div style={{ width: 320 }}>
+                {renderGroup(
+                  <FieldGroup>
+                    <Field orientation={orientation}>
+                      {renderControl("stacked")}
+                      <FieldLabel htmlFor="stacked">Project updates</FieldLabel>
+                    </Field>
+                    {renderControl("standalone")}
+                  </FieldGroup>,
+                )}
+              </div>
+            </DensityProvider>
+          </ThemeProvider>,
+        );
+        const [stacked, standalone] = [...document.querySelectorAll(`[data-slot="${slot}"]`)].map((element) =>
+          element.getBoundingClientRect(),
+        );
+
+        expect({ density, orientation, width: stacked!.width, height: stacked!.height }).toEqual({
+          density,
+          orientation,
+          width: standalone!.width,
+          height: standalone!.height,
+        });
+        await screen.unmount();
+      }
+    }
+  },
+);
