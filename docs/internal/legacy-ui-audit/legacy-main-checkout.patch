+        <SidebarInset>
+          <SidebarTrigger />
+        </SidebarInset>
+      </SidebarProvider>
+    </ThemeProvider>,
+  );
+  const animatedParts = ["sidebar-gap", "sidebar-container", "sidebar-group-label"].map((slot) =>
+    document.querySelector(`[data-slot="${slot}"]`)!,
