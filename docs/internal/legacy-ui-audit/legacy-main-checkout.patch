+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import {
+  Questionnaire,
+  QuestionnaireActions,
+  QuestionnaireChoice,
+  QuestionnaireChoiceDescription,
+  QuestionnaireChoices,
+  QuestionnaireItem,
+  QuestionnaireNext,
+  QuestionnairePrevious,
+  QuestionnaireSubmit,
+  QuestionnaireTitle,
+} from "../Questionnaire";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+
+// Consumer actions such as a reset button sit beside the built-in navigation and keep their content width.
+test("an extra questionnaire action keeps its content width while Previous is hidden", async () => {
+  for (const density of DENSITIES) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <DensityProvider density={density}>
+          <div style={{ width: 520 }}>
+            <Questionnaire>
+              <QuestionnaireItem name="project">
+                <QuestionnaireTitle>What should we build?</QuestionnaireTitle>
+                <QuestionnaireChoices>
+                  <QuestionnaireChoice value="library">Component library</QuestionnaireChoice>
+                </QuestionnaireChoices>
+              </QuestionnaireItem>
+              <QuestionnaireItem name="schedule">
+                <QuestionnaireTitle>When should work begin?</QuestionnaireTitle>
+                <QuestionnaireChoices>
+                  <QuestionnaireChoice value="now">Start now</QuestionnaireChoice>
+                </QuestionnaireChoices>
+              </QuestionnaireItem>
+              <QuestionnaireActions>
+                <QuestionnairePrevious />
+                <QuestionnaireNext />
+                <QuestionnaireSubmit />
+                <Button type="reset">Reset draft</Button>
+              </QuestionnaireActions>
+            </Questionnaire>
+            <Button type="button">Reset draft</Button>
+          </div>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const [action, standalone] = screen.getByRole("button", { name: "Reset draft" }).elements();
+
+    await expect
+      .element(document.querySelector<HTMLButtonElement>("[data-slot=questionnaire-previous]"))
+      .not.toBeVisible();
+    expect({ density, width: action!.getBoundingClientRect().width }).toEqual({
+      density,
+      width: standalone!.getBoundingClientRect().width,
+    });
+    await screen.unmount();
+  }
+});
+
+const CHOICE_TYPES = [
+  { type: "radio", isMultiple: false },
+  { type: "checkbox", isMultiple: true },
+] as const;
+
+const CHOICE_CONTENTS = [
+  { content: "plain", children: "Component library" },
+  {
+    content: "described",
+    children: (
+      <>
+        Component library
+        <QuestionnaireChoiceDescription>Reusable primitives and stories.</QuestionnaireChoiceDescription>
+      </>
+    ),
+  },
+] as const;
+
+function blockCentre(rect: DOMRect): number {
+  return rect.top + rect.height / 2;
+}
+
+// The label's first line box starts at its top edge and spans one computed line height.
+function firstLineCentre(label: Element): number {
+  return label.getBoundingClientRect().top + Number.parseFloat(getComputedStyle(label).lineHeight) / 2;
+}
+
+// The indicator and shortcut box must sit on the centre of the label's first line, with or without a description.
+test("a choice centres its indicator and shortcut on the first label line", async () => {
+  for (const density of DENSITIES) {
+    for (const { type, isMultiple } of CHOICE_TYPES) {
+      for (const { content, children } of CHOICE_CONTENTS) {
+        const screen = await render(
+          <ThemeProvider forcedTheme="light">
+            <DensityProvider density={density}>
+              <div style={{ width: 360 }}>
+                <Questionnaire shortcuts="letters">
+                  <QuestionnaireItem name="project" multiple={isMultiple}>
+                    <QuestionnaireTitle>What should we build?</QuestionnaireTitle>
+                    <QuestionnaireChoices>
+                      <QuestionnaireChoice value="library">{children}</QuestionnaireChoice>
+                    </QuestionnaireChoices>
+                  </QuestionnaireItem>
+                </Questionnaire>
+              </div>
+            </DensityProvider>
+          </ThemeProvider>,
+        );
+        const slot = (name: string) => document.querySelector(`[data-slot=questionnaire-choice-${name}]`)!;
+        const line = firstLineCentre(slot("label"));
+        const offset = (name: string) => blockCentre(slot(name).getBoundingClientRect()) - line;
+
+        expect({ density, type, content, indicator: offset("indicator"), shortcut: offset("shortcut") }).toEqual({
+          density,
+          type,
+          content,
+          indicator: expect.closeTo(0, 1),
+          shortcut: expect.closeTo(0, 1),
+        });
+        await screen.unmount();
+      }
+    }
+  }
+});
