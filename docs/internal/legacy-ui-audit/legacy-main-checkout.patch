+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { DensityProvider } from "../DensityProvider";
+import {
+  Pagination,
+  PaginationContent,
+  PaginationEllipsis,
+  PaginationItem,
+  PaginationLink,
+  PaginationNext,
+  PaginationPrevious,
+} from "../Pagination";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+
+function blockCentre(element: Element): number {
+  const rect = element.getBoundingClientRect();
+  return rect.top + rect.height / 2;
+}
+
+// Every pagination control shares the row's centre, whether its first child is an icon or text.
+test("pagination controls share the content row's centre", async () => {
+  for (const density of DENSITIES) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <DensityProvider density={density}>
+          <Pagination>
+            <PaginationContent>
+              <PaginationItem>
+                <PaginationPrevious href="#page-1" />
+              </PaginationItem>
+              <PaginationItem>
+                <PaginationLink href="#page-1" isActive>
+                  1
+                </PaginationLink>
+              </PaginationItem>
+              <PaginationItem>
+                <PaginationEllipsis />
+              </PaginationItem>
+              <PaginationItem>
+                <PaginationNext href="#page-2" />
+              </PaginationItem>
+            </PaginationContent>
+          </Pagination>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const row = blockCentre(document.querySelector("[data-slot=pagination-content]")!);
+    const offset = (selector: string) => blockCentre(document.querySelector(selector)!) - row;
+
+    expect({
+      density,
+      previous: offset("[aria-label='Go to previous page']"),
+      page: offset("[aria-current=page]"),
+      ellipsis: offset("[data-slot=pagination-ellipsis]"),
+      next: offset("[aria-label='Go to next page']"),
+    }).toEqual({
+      density,
+      previous: expect.closeTo(0, 1),
+      page: expect.closeTo(0, 1),
+      ellipsis: expect.closeTo(0, 1),
+      next: expect.closeTo(0, 1),
+    });
+    await screen.unmount();
+  }
+});
