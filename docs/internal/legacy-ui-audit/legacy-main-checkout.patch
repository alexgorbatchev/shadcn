+  SidebarMenuSkeleton,
+  SidebarProvider,
+} from "../Sidebar";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+function resolveTokenColor(token: string): string {
+  const probe = document.createElement("span");
+  probe.style.color = `var(${token})`;
+  document.body.append(probe);
+  const color = getComputedStyle(probe).color;
+  probe.remove();
+  return color;
+}
+
+function readShadowLayers(element: Element): string[] {
+  return getComputedStyle(element).boxShadow.split(/,\s*(?![^()]*\))/);
+}
+
+test("the outline menu button draws a 1px ring in the sidebar border colour, and the accent colour on hover", async () => {
+  await page.viewport(1024, 480);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <SidebarProvider>
+        <SidebarMenu>
+          <SidebarMenuItem>
+            <SidebarMenuButton variant="outline">Outline</SidebarMenuButton>
+          </SidebarMenuItem>
+        </SidebarMenu>
+        <p>Pointer rest</p>
+      </SidebarProvider>
+    </ThemeProvider>,
+  );
+  const button = page.getByRole("button", { name: "Outline" }).element();
+
+  await userEvent.hover(page.getByText("Pointer rest"));
+  expect(readShadowLayers(button)).toContain(`${resolveTokenColor("--sidebar-border")} 0px 0px 0px 1px`);
+
+  await userEvent.hover(button);
+  await expect
+    .poll(() => readShadowLayers(button))
+    .toContain(`${resolveTokenColor("--sidebar-accent")} 0px 0px 0px 1px`);
+  await screen.unmount();
+});
+
+function SkeletonMenu(): ReactElement {
+  const menuRef = useRef<HTMLUListElement>(null);
+  useEffect(() => {
+    menuRef.current!.dataset.hydrated = "true";
+  }, []);
+
+  return (
+    <SidebarMenu ref={menuRef}>
+      {Array.from({ length: 6 }, (_, index) => (
+        <SidebarMenuItem key={index}>
+          <SidebarMenuSkeleton role="status" aria-label={`Loading item ${index + 1}`} />
+        </SidebarMenuItem>
+      ))}
+    </SidebarMenu>
+  );
+}
+
+test("menu skeleton widths hydrate from server markup without mismatches", async () => {
+  const container = document.createElement("div");
+  container.innerHTML = renderToString(<SkeletonMenu />);
+  document.body.append(container);
+  const readWidths = (): number[] =>
+    Array.from(container.querySelectorAll<HTMLElement>('[data-sidebar="menu-skeleton-text"]'), (skeleton) =>
+      Number.parseFloat(skeleton.style.getPropertyValue("--skeleton-width")),
+    );
+  const serverWidths = readWidths();
+  const consoleError = vi.spyOn(console, "error").mockImplementation(() => {});
+  const recoverableErrors: unknown[] = [];
+  const root = hydrateRoot(container, <SkeletonMenu />, {
+    onRecoverableError: (error) => recoverableErrors.push(error),
+  });
+
+  try {
+    await expect
+      .poll(() => container.querySelector<HTMLElement>('[data-slot="sidebar-menu"]')?.dataset.hydrated)
+      .toBe("true");
+    expect(consoleError).not.toHaveBeenCalled();
+    expect(recoverableErrors).toEqual([]);
+    expect(readWidths()).toEqual(serverWidths);
+    expect(serverWidths.every((width) => width >= 50 && width < 90)).toBe(true);
+    expect(new Set(serverWidths).size).toBeGreaterThan(1);
+  } finally {
+    consoleError.mockRestore();
+    root.unmount();
+    container.remove();
+  }
+});
+
+const DENSITIES = ["comfortable", "compact"] as const;
+
+function readTextStart(element: Element): number {
+  const range = document.createRange();
+  range.selectNodeContents(element);
+  return range.getBoundingClientRect().left;
+}
+
+function MenuIcon(): ReactElement {
+  return (
+    <svg viewBox="0 0 16 16" aria-hidden="true">
+      <rect width="16" height="16" fill="currentColor" />
+    </svg>
+  );
+}
+
+test.each(DENSITIES)("%s menu badges stay vertically centred inside every menu button size", async (density) => {
+  await page.viewport(1024, 480);
+  const sizes = ["sm", "default", "lg"] as const;
+  const screen = await render(
+    <SidebarProvider density={density}>
+      <SidebarMenu>
+        {sizes.map((size) => (
+          <SidebarMenuItem key={size}>
+            <SidebarMenuButton size={size}>
+              <span>{size} item</span>
+            </SidebarMenuButton>
+            <SidebarMenuBadge>12</SidebarMenuBadge>
+          </SidebarMenuItem>
+        ))}
+      </SidebarMenu>
+    </SidebarProvider>,
+  );
+
+  for (const size of sizes) {
+    const button = page.getByRole("button", { name: `${size} item` }).element();
+    const badge = button.parentElement!.querySelector('[data-sidebar="menu-badge"]')!;
+    const buttonRect = button.getBoundingClientRect();
+    const badgeRect = badge.getBoundingClientRect();
+
+    expect(badgeRect.top).toBeGreaterThanOrEqual(buttonRect.top);
+    expect(badgeRect.bottom).toBeLessThanOrEqual(buttonRect.bottom);
+    expect(badgeRect.top + badgeRect.height / 2).toBeCloseTo(buttonRect.top + buttonRect.height / 2, 1);
+  }
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s group label text lines up with menu button text", async (density) => {
+  await page.viewport(1024, 480);
+  const screen = await render(
+    <SidebarProvider density={density}>
+      <SidebarGroup>
+        <SidebarGroupLabel>Projects</SidebarGroupLabel>
+        <SidebarGroupContent>
+          <SidebarMenu>
+            <SidebarMenuItem>
+              <SidebarMenuButton>
+                <span>Inbox</span>
+              </SidebarMenuButton>
+            </SidebarMenuItem>
+          </SidebarMenu>
+        </SidebarGroupContent>
+      </SidebarGroup>
+    </SidebarProvider>,
+  );
+
+  expect(readTextStart(page.getByText("Projects").element())).toBeCloseTo(
+    readTextStart(page.getByText("Inbox").element()),
+    1,
+  );
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s collapsed icon sidebar removes the group label from the layout", async (density) => {
+  await page.viewport(1024, 480);
+  const screen = await render(
+    <SidebarProvider density={density} open={false}>
+      <Sidebar collapsible="icon">
+        <SidebarContent>
+          <SidebarGroup>
+            <SidebarGroupLabel>Projects</SidebarGroupLabel>
+            <SidebarGroupContent>
+              <SidebarMenu>
+                <SidebarMenuItem>
+                  <SidebarMenuButton>
+                    <MenuIcon />
+                    <span>Inbox</span>
+                  </SidebarMenuButton>
+                </SidebarMenuItem>
+              </SidebarMenu>
+            </SidebarGroupContent>
+          </SidebarGroup>
+        </SidebarContent>
+      </Sidebar>
+    </SidebarProvider>,
+  );
+  const group = screen.container.querySelector('[data-sidebar="group"]')!;
+  const content = screen.container.querySelector('[data-sidebar="group-content"]')!;
+  const contentOffset = (): number => content.getBoundingClientRect().top - group.getBoundingClientRect().top;
+
+  await expect.poll(contentOffset).toBeCloseTo(Number.parseFloat(getComputedStyle(group).paddingTop), 1);
+  await screen.unmount();
+});
+
+test("collapsed icon menu buttons hide raw text labels exactly like span-wrapped labels while keeping the accessible name", async () => {
+  await page.viewport(1024, 480);
+  const renderCollapsedButton = (label: ReactElement | string): ReactElement => (
+    <ThemeProvider forcedTheme="light">
+      <SidebarProvider open={false}>
+        <Sidebar collapsible="icon">
+          <SidebarContent>
+            <SidebarMenu>
+              <SidebarMenuItem>
+                <SidebarMenuButton>
+                  <MenuIcon />
+                  {label}
+                </SidebarMenuButton>
+              </SidebarMenuItem>
+            </SidebarMenu>
+          </SidebarContent>
+        </Sidebar>
+      </SidebarProvider>
+    </ThemeProvider>
+  );
+  const captureButton = async (): Promise<string> => {
+    const button = page.getByRole("button", { name: "Settings" });
+    await expect.element(button).toBeVisible();
+    await expect
+      .poll(() => {
+        const { width, height } = button.element().getBoundingClientRect();
+        return width === height;
+      })
+      .toBe(true);
+    return page.screenshot({ element: button.element(), save: false });
+  };
+
+  const screen = await render(renderCollapsedButton(<span>Settings</span>));
+  const spanWrapped = await captureButton();
+  await screen.rerender(renderCollapsedButton("Settings"));
+  const rawText = await captureButton();
+
+  expect(rawText).toBe(spanWrapped);
