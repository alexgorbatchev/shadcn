+// Measures the gap between a trigger's inline-start padding edge and the start of its icon and label, so a wide trigger
+// reads like a field value instead of a centred action. The inline-start side follows the trigger's resolved direction.
+function measureInlineStartGap(trigger: HTMLElement): number {
+  const style = getComputedStyle(trigger);
+  const box = trigger.getBoundingClientRect();
+  const range = trigger.ownerDocument.createRange();
+  range.selectNodeContents(trigger);
+  const content = range.getBoundingClientRect();
+  const gaps: Record<string, number> = {
+    ltr: content.left - (box.left + Number.parseFloat(style.borderLeftWidth) + Number.parseFloat(style.paddingLeft)),
+    rtl: box.right - Number.parseFloat(style.borderRightWidth) - Number.parseFloat(style.paddingRight) - content.right,
+  };
+  return Math.round(gaps[style.direction]);
+}
