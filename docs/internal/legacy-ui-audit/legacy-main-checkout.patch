+import { measureBlockOverflow } from "./helpers";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const INLINE_ALIGNS = ["inline-start", "inline-end"] as const;
+const ADDON_CONTENTS: Record<string, ReactNode> = {
+  icon: <SearchIcon aria-hidden />,
+  text: <InputGroupText>USD</InputGroupText>,
+  kbd: <Kbd>⌘K</Kbd>,
+  "button-xs": <InputGroupButton size="xs">Copy</InputGroupButton>,
+  "button-sm": <InputGroupButton size="sm">Copy</InputGroupButton>,
+  "button-icon-xs": (
+    <InputGroupButton size="icon-xs" aria-label="Search">
+      <SearchIcon aria-hidden />
+    </InputGroupButton>
+  ),
+  "button-icon-sm": (
+    <InputGroupButton size="icon-sm" aria-label="Search">
+      <SearchIcon aria-hidden />
+    </InputGroupButton>
+  ),
+};
+
+// An inline addon that pokes out of its fixed-height group captures pointer events over neighbouring content and
+// spills into the surrounding layout's scrollable overflow.
+test("inline addons stay within the input group height at every density", async () => {
+  const measured = [];
+  for (const density of DENSITIES) {
+    for (const align of INLINE_ALIGNS) {
+      for (const [content, addon] of Object.entries(ADDON_CONTENTS)) {
+        const screen = await render(
+          <ThemeProvider forcedTheme="light">
+            <DensityProvider density={density}>
+              <InputGroup className="w-64">
+                <InputGroupInput aria-label="Amount" />
+                <InputGroupAddon align={align}>{addon}</InputGroupAddon>
+              </InputGroup>
+            </DensityProvider>
+          </ThemeProvider>,
+        );
+        const group = document.querySelector("[data-slot=input-group]")!;
+        const addonElement = group.querySelector("[data-slot=input-group-addon]")!;
+        measured.push({ density, align, content, overflow: measureBlockOverflow(addonElement, group) });
+        await screen.unmount();
+      }
+    }
+  }
+
+  expect(measured).toEqual(measured.map((entry) => ({ ...entry, overflow: 0 })));
+});
diff --git a/src/components/__tests__/InputOTP.test.tsx b/src/components/__tests__/InputOTP.test.tsx
new file mode 100644
index 0000000..f18b52e
--- /dev/null
+++ b/src/components/__tests__/InputOTP.test.tsx
@@ -0,0 +1,72 @@
+import { expect, test } from "vitest";
+import { page } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import { InputOTP, InputOTPGroup, InputOTPSlot } from "../InputOTP";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, isSameColor, readPixel } from "./helpers";
+import type { Rgba } from "./helpers";
+import "../../../.storybook/preview.css";
+
+type Theme = "light" | "dark";
+
+// Rasterises a CSS colour so it compares against screenshot pixels whatever colour syntax the theme uses.
+function rasterizeColor(color: string): Rgba {
+  const context = new OffscreenCanvas(1, 1).getContext("2d")!;
+  context.fillStyle = color;
+  context.fillRect(0, 0, 1, 1);
+  const [red, green, blue, alpha] = context.getImageData(0, 0, 1, 1).data;
+  return [red!, green!, blue!, alpha!];
+}
+
+// WCAG 2.x relative luminance and contrast ratio for opaque sRGB colours.
+function readLuminance([red, green, blue]: Rgba): number {
+  const [r, g, b] = [red, green, blue].map((channel) => {
+    const value = channel / 255;
+    return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
+}
+
+function readContrastRatio(foreground: Rgba, background: Rgba): number {
+  const [lighter, darker] = [readLuminance(foreground), readLuminance(background)].sort((left, right) => right - left);
+  return (lighter! + 0.05) / (darker! + 0.05);
+}
+
+test.each(["light", "dark"] satisfies Theme[])(
+  "InputOTP slots keep characters, placeholders and slot borders legible against the slot fill in %s theme",
+  async (theme) => {
+    await page.viewport(480, 240);
+    const screen = await render(
+      <ThemeProvider forcedTheme={theme}>
+        <div className="bg-background p-6">
+          <InputOTP maxLength={3} aria-label="Code" placeholder="000" defaultValue="1">
+            <InputOTPGroup>
+              <InputOTPSlot index={0} />
+              <InputOTPSlot index={1} />
+              <InputOTPSlot index={2} />
+            </InputOTPGroup>
+          </InputOTP>
+        </div>
+      </ThemeProvider>,
+    );
+    const [filledSlot, placeholderSlot] = document.querySelectorAll<HTMLElement>('[data-slot="input-otp-slot"]');
+    const placeholder = placeholderSlot?.querySelector("span");
+    if (!filledSlot || !placeholderSlot || !placeholder) {
+      throw new Error("Expected a filled slot and a placeholder slot");
+    }
+
+    // The middle slot is inactive and unfocused, so its edge pixel is the slot border and a pixel beside the glyph is
+    // the composited fill.
+    const image = await captureImageData(placeholderSlot);
+    const fill = readPixel(image, 2, Math.floor(image.height / 2));
+    const border = readPixel(image, Math.floor(image.width / 2), 0);
+    const characterColor = rasterizeColor(getComputedStyle(filledSlot).color);
+    const placeholderColor = rasterizeColor(getComputedStyle(placeholder).color);
+
+    expect(isSameColor(border, fill)).toBe(false);
+    expect(readContrastRatio(characterColor, fill)).toBeGreaterThanOrEqual(4.5);
+    expect(readContrastRatio(placeholderColor, fill)).toBeGreaterThanOrEqual(4.5);
+    expect(isSameColor(placeholderColor, characterColor)).toBe(false);
+    await screen.unmount();
+  },
+);
diff --git a/src/components/__tests__/InvalidIndicators.test.tsx b/src/components/__tests__/InvalidIndicators.test.tsx
new file mode 100644
index 0000000..351571b
--- /dev/null
+++ b/src/components/__tests__/InvalidIndicators.test.tsx
@@ -0,0 +1,148 @@
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import { Button } from "../Button";
+import { Checkbox } from "../Checkbox";
+import { Combobox, ComboboxChips, ComboboxChipsInput } from "../Combobox";
+import { Input } from "../Input";
+import { InputGroup, InputGroupInput } from "../InputGroup";
+import { NativeSelect, NativeSelectOption } from "../NativeSelect";
+import { Questionnaire, QuestionnaireInput, QuestionnaireItem } from "../Questionnaire";
+import { RadioGroup, RadioGroupItem } from "../RadioGroup";
+import { Select, SelectTrigger, SelectValue } from "../Select";
+import { Switch } from "../Switch";
+import { Textarea } from "../Textarea";
+import { ThemeProvider } from "../ThemeProvider";
+import { captureImageData, isSameColor, readPixel } from "./helpers";
+import type { Rgba } from "./helpers";
+import "../../../.storybook/preview.css";
+
+type Edge = { start: number; end: number; color: Rgba };
+
+type EdgeCapture = { rest: Edge; focused: Edge; frameStart: number; isFocused: boolean };
+
+type Control = [name: string, surface: ReactElement, frame: string];
+
+// Returns the first run of pixels on the row that differ from the canvas background, in CSS pixels relative to the
+// canvas. Field fills are within the colour tolerance of the background, so the run ends at the frame's inner edge.
+function readEdge(image: ImageData, row: number, scale: number): Edge {
+  const background = readPixel(image, 1, row);
+  let start = -1;
+  let end = image.width;
+  for (let x = 0; x < image.width; x += 1) {
+    const isBackground = isSameColor(readPixel(image, x, row), background);
+    if (!isBackground && start < 0) start = x;
+    if (isBackground && start >= 0) {
+      end = x;
+      break;
+    }
+  }
+  return { start: start / scale, end: end / scale, color: readPixel(image, start, row) };
+}
+
+// Renders an invalid control, reads its start edge at rest and after keyboard focus along the frame's midline.
+async function captureInvalidEdge(surface: ReactElement, frameSelector: string): Promise<EdgeCapture> {
+  await page.viewport(480, 240);
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <div data-testid="invalid-canvas" className="w-80 bg-background p-4">
+        {surface}
+      </div>
+    </ThemeProvider>,
+  );
+  const wrapper = page.getByTestId("invalid-canvas").element() as HTMLElement;
+  const frame = wrapper.querySelector<HTMLElement>(frameSelector)!;
+  const wrapperRect = wrapper.getBoundingClientRect();
+  const frameRect = frame.getBoundingClientRect();
+  const restImage = await captureImageData(wrapper);
+  await userEvent.tab();
+  const isFocused = frame.matches(":focus-visible, :has(:focus-visible)");
+  const focusedImage = await captureImageData(wrapper);
+  const scale = restImage.width / wrapperRect.width;
+  const row = Math.round((frameRect.top - wrapperRect.top + frameRect.height / 2) * scale);
+  const result: EdgeCapture = {
+    rest: readEdge(restImage, row, scale),
+    focused: readEdge(focusedImage, row, scale),
+    frameStart: frameRect.left - wrapperRect.left,
+    isFocused,
+  };
+  await screen.unmount();
+  return result;
+}
+
+const controls: Control[] = [
+  ["Input", <Input aria-label="Name" aria-invalid />, '[data-slot="input"]'],
+  ["Textarea", <Textarea aria-label="Notes" aria-invalid />, '[data-slot="textarea"]'],
+  [
+    "NativeSelect",
+    <NativeSelect aria-label="Region" aria-invalid defaultValue="east">
+      <NativeSelectOption value="east">East</NativeSelectOption>
+    </NativeSelect>,
+    '[data-slot="native-select"]',
+  ],
+  [
+    "SelectTrigger",
+    <Select defaultValue="east" items={{ east: "East" }}>
+      <SelectTrigger aria-label="Region" aria-invalid>
+        <SelectValue />
+      </SelectTrigger>
+    </Select>,
+    '[data-slot="select-trigger"]',
+  ],
+  [
+    "InputGroup",
+    <InputGroup>
+      <InputGroupInput aria-label="Search" aria-invalid />
+    </InputGroup>,
+    '[data-slot="input-group"]',
+  ],
+  [
+    "ComboboxChips",
+    <Combobox multiple items={["East"]}>
+      <ComboboxChips>
+        <ComboboxChipsInput aria-label="Regions" aria-invalid />
+      </ComboboxChips>
+    </Combobox>,
+    '[data-slot="combobox-chips"]',
+  ],
+  [
+    "QuestionnaireInput",
+    <Questionnaire>
+      <QuestionnaireItem name="code" invalid>
+        <QuestionnaireInput aria-label="Code" />
+      </QuestionnaireItem>
+    </Questionnaire>,
+    '[data-slot="questionnaire-input"]',
+  ],
+  ["Checkbox", <Checkbox aria-label="Accept" aria-invalid />, '[data-slot="checkbox"]'],
+  [
+    "RadioGroupItem",
+    <RadioGroup aria-label="Plan">
+      <RadioGroupItem value="team" aria-label="Team" aria-invalid />
+    </RadioGroup>,
+    '[data-slot="radio-group-item"]',
+  ],
+  ["Switch", <Switch aria-label="Alerts" aria-invalid />, '[data-slot="switch"]'],
+];
+
+// Invalid state is shown by the destructive border at rest; the focus ring keeps Input's thickness and takes the
+// destructive colour, so adjacent invalid controls do not merge permanent halos.
+test.each(controls)("invalid %s has no resting halo and a destructive focus ring", async (_name, surface, frame) => {
+  const valid = await captureInvalidEdge(<Input aria-label="Reference" />, '[data-slot="input"]');
+  const invalid = await captureInvalidEdge(surface, frame);
+
+  expect(invalid.isFocused).toBe(true);
+  expect(invalid.rest.start).toBeGreaterThanOrEqual(invalid.frameStart - 0.5);
+  expect(isSameColor(invalid.focused.color, invalid.rest.color)).toBe(true);
+  expect(invalid.focused.end - invalid.focused.start).toBe(valid.focused.end - valid.focused.start);
+});
+
+// Button keeps its offset outline focus pattern; an invalid Button draws that outline in the destructive colour.
+test("invalid Button has no resting halo and a destructive focus outline", async () => {
+  const invalid = await captureInvalidEdge(<Button aria-invalid>Retry</Button>, '[data-slot="button"]');
+
+  expect(invalid.isFocused).toBe(true);
+  expect(invalid.rest.start).toBeGreaterThanOrEqual(invalid.frameStart - 0.5);
+  expect(isSameColor(invalid.focused.color, invalid.rest.color)).toBe(true);
+});
