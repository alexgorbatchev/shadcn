+}
+// Resolves a scroll-fade edge size through a fixed probe so the assertion reads rendered length, not serialization.
+// The probe mutates the DOM, so callers must not measure inside waitFor, whose mutation observer would re-enter it.
+function measureScrollFade(group: HTMLElement, edge: "s" | "e"): number {
+  const probe = group.ownerDocument.createElement("span");
+  probe.style.cssText = `position: fixed; --scroll-fade-${edge}: inherit; inline-size: var(--scroll-fade-${edge}); block-size: 0`;
+  group.append(probe);
+  const { width } = probe.getBoundingClientRect();
+  probe.remove();
+  return width;
+}
