+import { expect, test } from "vitest";
+import { page } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import { DensityProvider } from "../DensityProvider";
+import { Progress, ProgressLabel } from "../Progress";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+function getSlot(root: Element, slot: string): HTMLElement {
+  const element = root.querySelector<HTMLElement>(`[data-slot="${slot}"]`);
+  if (!element) throw new Error(`Missing ${slot}`);
+  return element;
+}
+
+function visibleWidth(indicator: HTMLElement, track: HTMLElement): number {
+  const indicatorRect = indicator.getBoundingClientRect();
+  const trackRect = track.getBoundingClientRect();
+  return Math.max(0, Math.min(indicatorRect.right, trackRect.right) - Math.max(indicatorRect.left, trackRect.left));
+}
+
+type Direction = "ltr" | "rtl";
+
+type IndicatorSample = { left: number; visibleWidth: number };
+
+function sampleIndicator(indicator: HTMLElement, track: HTMLElement, durationMs: number): Promise<IndicatorSample[]> {
+  return new Promise((resolve) => {
+    const samples: IndicatorSample[] = [];
+    const startedAt = performance.now();
+    const sample = (now: number) => {
+      samples.push({ left: indicator.getBoundingClientRect().left, visibleWidth: visibleWidth(indicator, track) });
+      if (now - startedAt < durationMs) requestAnimationFrame(sample);
+      else resolve(samples);
+    };
+    requestAnimationFrame(sample);
+  });
+}
+
+test.each(["ltr", "rtl"] satisfies Direction[])(
+  "an indeterminate progress bar sweeps a visible indicator through its track in %s",
+  async (direction) => {
+    await page.viewport(480, 240);
+    const screen = await render(
+      <ThemeProvider forcedTheme="dark">
+        <DensityProvider density="comfortable">
+          <Progress value={null} dir={direction} className="w-64">
+            <ProgressLabel>Upload progress</ProgressLabel>
+          </Progress>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const progress = screen.getByRole("progressbar", { name: "Upload progress" }).element();
+    const track = getSlot(progress, "progress-track");
+    const indicator = getSlot(progress, "progress-indicator");
+
+    const samples = await sampleIndicator(indicator, track, 1500);
+    const visibleSamples = samples.filter((sample) => sample.visibleWidth > 0);
+    expect(new Set(samples.map((sample) => Math.round(sample.left))).size).toBeGreaterThan(10);
+    expect(visibleSamples.length / samples.length).toBeGreaterThan(0.8);
+    await screen.unmount();
+  },
+);
