+
+type Typography = { fontSize: string; lineHeight: string; fontWeight: string; letterSpacing: string; color: string };
+
+function Frame({ children }: { children: ReactElement }): ReactElement {
+  return (
+    <ThemeProvider forcedTheme="dark">
+      <DensityProvider density="comfortable">{children}</DensityProvider>
+    </ThemeProvider>
+  );
+}
+
+function readTypography(selector: string): Typography {
+  const element = document.querySelector<HTMLElement>(selector);
+  if (!element) throw new Error(`Missing ${selector}`);
+  const style = getComputedStyle(element);
+  return {
+    fontSize: style.fontSize,
+    lineHeight: style.lineHeight,
+    fontWeight: style.fontWeight,
+    letterSpacing: style.letterSpacing,
+    color: style.color,
+  };
+}
+
+async function measure({ surface, slot, open }: Surface): Promise<Typography> {
+  const screen = await render(<Frame>{surface}</Frame>);
+  await open?.(screen);
+  await expect.poll(() => document.querySelector(slot)).not.toBeNull();
+  const result = readTypography(slot);
+  await screen.unmount();
+  return result;
+}
+
+const modalTitles: Surface[] = [
