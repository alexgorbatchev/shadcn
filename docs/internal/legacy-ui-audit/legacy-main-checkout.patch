+  await page.getByRole("button", { name: "Toggle Sidebar" }).click();
+
+  expect(animatedParts.flatMap(readRunningAnimations)).toEqual([]);
+  expect(container.getBoundingClientRect().width).toBeLessThan(expandedWidth);
