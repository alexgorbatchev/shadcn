@@ -0,0 +1,77 @@
+import { FileIcon } from "lucide-react";
+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { DensityProvider } from "../DensityProvider";
+import { Item, ItemContent, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "../Item";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const SIZES = ["default", "sm", "xs"] as const;
+
+// The small size must be a real step down: the same content sits closer to the item's edges and to its media.
+test("a small item insets its content less than a default item", async () => {
+  for (const density of DENSITIES) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <DensityProvider density={density}>
+          <div className="flex w-96 flex-col gap-4">
+            {(["default", "sm"] as const).map((size) => (
+              <Item key={size} data-testid={`${size}-item`} size={size} variant="outline">
+                <ItemMedia data-testid={`${size}-media`} variant="icon">
+                  <FileIcon />
+                </ItemMedia>
+                <ItemContent data-testid={`${size}-content`}>
+                  <ItemTitle>Project notes</ItemTitle>
+                </ItemContent>
+              </Item>
+            ))}
+          </div>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const rect = (testId: string) => screen.getByTestId(testId).element().getBoundingClientRect();
+    const spacing = (size: "default" | "sm") => ({
+      block: rect(`${size}-content`).top - rect(`${size}-item`).top,
+      inline: rect(`${size}-media`).left - rect(`${size}-item`).left,
+      gap: rect(`${size}-content`).left - rect(`${size}-media`).right,
+    });
+    const regular = spacing("default");
+    const small = spacing("sm");
+
+    expect({ density, isSmallerBlock: small.block < regular.block }).toEqual({ density, isSmallerBlock: true });
+    expect({ density, isSmallerInline: small.inline < regular.inline }).toEqual({ density, isSmallerInline: true });
+    expect({ density, isSmallerGap: small.gap < regular.gap }).toEqual({ density, isSmallerGap: true });
+    await screen.unmount();
+  }
+});
+
+// A separator sits in the group's flow, so the group gap alone must space it from the items on either side.
+test("an item separator is spaced from its neighbours by the group gap", async () => {
+  for (const size of SIZES) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <ItemGroup data-testid="group" aria-label="Documents" className="w-96">
+          <Item data-testid="previous" size={size} role="listitem">
+            <ItemContent>
+              <ItemTitle>Project notes</ItemTitle>
+            </ItemContent>
+          </Item>
+          <ItemSeparator data-testid="separator" />
+          <Item data-testid="next" size={size} role="listitem">
+            <ItemContent>
+              <ItemTitle>Archive</ItemTitle>
+            </ItemContent>
+          </Item>
+        </ItemGroup>
+      </ThemeProvider>,
+    );
+    const rect = (testId: string) => screen.getByTestId(testId).element().getBoundingClientRect();
+    const groupGap = Number.parseFloat(getComputedStyle(screen.getByTestId("group").element()).rowGap);
+
+    expect({ size, before: rect("separator").top - rect("previous").bottom }).toEqual({ size, before: groupGap });
+    expect({ size, after: rect("next").top - rect("separator").bottom }).toEqual({ size, after: groupGap });
+    await screen.unmount();
+  }
+});
