@@ -0,0 +1,231 @@
+import type { ReactElement } from "react";
+import { BookmarkIcon } from "lucide-react";
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import { Button } from "../Button";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import { Toggle } from "../Toggle";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] as const;
+const THEMES = ["light", "dark"] as const;
+
+type Surface = { backgroundColor: string; color: string };
+type FocusIndicator = {
+  borderColor: string;
+  boxShadow: string;
+  outlineColor: string;
+  outlineOffset: string;
+  outlineStyle: string;
+  outlineWidth: string;
+};
+
+async function settle(element: Element): Promise<CSSStyleDeclaration> {
+  await expect.poll(() => element.getAnimations().length).toBe(0);
+  return getComputedStyle(element);
+}
+
+async function readSurface(element: Element): Promise<Surface> {
+  const { backgroundColor, color } = await settle(element);
+  return { backgroundColor, color };
+}
+
+async function readFocusIndicator(element: Element): Promise<FocusIndicator> {
+  const { borderColor, boxShadow, outlineColor, outlineOffset, outlineStyle, outlineWidth } = await settle(element);
+  return { borderColor, boxShadow, outlineColor, outlineOffset, outlineStyle, outlineWidth };
+}
+
+function resolveTokenColor(token: string): string {
+  const probe = document.createElement("span");
+  probe.style.color = `var(${token})`;
+  document.body.append(probe);
+  const color = getComputedStyle(probe).color;
+  probe.remove();
+  return color;
+}
+
+test.each(THEMES)("%s pressed toggles use the default Button surface at rest and on hover", async (theme) => {
+  await page.viewport(1024, 480);
+  const screen = await render(
+    <ThemeProvider forcedTheme={theme}>
+      <div className="flex gap-2 bg-background p-4">
+        <Button>Reference</Button>
+        <Toggle>Bold</Toggle>
+        <Toggle defaultPressed>Italic</Toggle>
+      </div>
+      <p>Pointer rest</p>
+    </ThemeProvider>,
+  );
+  const reference = page.getByRole("button", { name: "Reference" });
+  const unpressed = page.getByRole("button", { name: "Bold" });
+  const pressed = page.getByRole("button", { name: "Italic" });
+
+  await userEvent.hover(page.getByText("Pointer rest"));
+  const pressedAtRest = await readSurface(pressed.element());
+  expect(pressedAtRest).toEqual(await readSurface(reference.element()));
+
+  await userEvent.hover(reference);
+  const referenceHovered = await readSurface(reference.element());
+  await userEvent.hover(pressed);
+  expect(await readSurface(pressed.element())).toEqual(referenceHovered);
+
+  await userEvent.hover(unpressed);
+  const unpressedHovered = await readSurface(unpressed.element());
+  expect(unpressedHovered.backgroundColor).toBe(resolveTokenColor("--muted"));
+  expect(unpressedHovered.backgroundColor).not.toBe(pressedAtRest.backgroundColor);
+  await screen.unmount();
+});
+
+test.each([false, true])(
+  "keyboard focus draws the default Button outline when aria-invalid is %s",
+  async (isInvalid) => {
+    await page.viewport(1024, 480);
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <div className="flex gap-2 bg-background p-4">
+          <Button aria-invalid={isInvalid}>Reference</Button>
+          <Toggle aria-invalid={isInvalid}>Bold</Toggle>
+          <Toggle aria-invalid={isInvalid} defaultPressed>
+            Italic
+          </Toggle>
+          <Toggle aria-invalid={isInvalid} variant="outline" defaultPressed>
+            Underline
+          </Toggle>
+        </div>
+      </ThemeProvider>,
+    );
+    const unpressed = page.getByRole("button", { name: "Bold" }).element();
+    const pressed = page.getByRole("button", { name: "Italic" }).element();
+    const unpressedAtRest = await readFocusIndicator(unpressed);
+    const pressedAtRest = await readFocusIndicator(pressed);
+    expect(pressedAtRest.borderColor).toBe(unpressedAtRest.borderColor);
+    expect((await readFocusIndicator(page.getByRole("button", { name: "Underline" }).element())).borderColor).toBe(
+      unpressedAtRest.borderColor,
+    );
+
+    await userEvent.tab();
+    const referenceFocused = await readFocusIndicator(page.getByRole("button", { name: "Reference" }).element());
+    const expectedOutline = {
+      outlineColor: referenceFocused.outlineColor,
+      outlineOffset: referenceFocused.outlineOffset,
+      outlineStyle: referenceFocused.outlineStyle,
+      outlineWidth: referenceFocused.outlineWidth,
+    };
+
+    await userEvent.tab();
+    await expect(document.activeElement).toBe(unpressed);
+    expect(await readFocusIndicator(unpressed)).toEqual({
+      ...expectedOutline,
+      borderColor: unpressedAtRest.borderColor,
+      boxShadow: unpressedAtRest.boxShadow,
+    });
+
+    await userEvent.tab();
+    await expect(document.activeElement).toBe(pressed);
+    expect(await readFocusIndicator(pressed)).toEqual({
+      ...expectedOutline,
+      borderColor: pressedAtRest.borderColor,
+      boxShadow: pressedAtRest.boxShadow,
+    });
+    await screen.unmount();
+  },
+);
+
+function BookmarkToggle({ label }: { label: string }): ReactElement {
+  return (
+    <Toggle aria-label={label}>
+      <BookmarkIcon data-icon="inline-start" />
+      <span>Bookmark</span>
+    </Toggle>
+  );
+}
+
+test.each(DENSITIES)("%s toggles keep their labels inside a row narrower than their content", async (density) => {
+  await page.viewport(320, 480);
+  const screen = await render(
+    <DensityProvider density={density}>
+      <div className="flex w-64 gap-4">
+        <BookmarkToggle label="First" />
+        <BookmarkToggle label="Second" />
+        <BookmarkToggle label="Third" />
+      </div>
+    </DensityProvider>,
+  );
+
+  for (const name of ["First", "Second", "Third"]) {
+    const toggle = page.getByRole("button", { name }).element();
+    const toggleRect = toggle.getBoundingClientRect();
+    const labelRect = toggle.querySelector("span")!.getBoundingClientRect();
+
+    expect(labelRect.left).toBeGreaterThanOrEqual(toggleRect.left);
+    expect(labelRect.right).toBeLessThanOrEqual(toggleRect.right);
+  }
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s icon toggles are square at the height of the matching text toggle", async (density) => {
+  await page.viewport(1024, 480);
+  const sizes = [
+    ["icon-sm", "sm"],
+    ["icon", "default"],
+    ["icon-lg", "lg"],
+  ] as const;
+  const screen = await render(
+    <DensityProvider density={density}>
+      {sizes.map(([iconSize, textSize]) => (
+        <div key={iconSize} className="flex gap-2">
+          <Toggle size={iconSize} aria-label={`${iconSize} bookmark`}>
+            <BookmarkIcon />
+          </Toggle>
+          <Toggle size={textSize}>{textSize} text</Toggle>
+        </div>
+      ))}
+    </DensityProvider>,
+  );
+
+  for (const [iconSize, textSize] of sizes) {
+    const textHeight = page
+      .getByRole("button", { name: `${textSize} text` })
+      .element()
+      .getBoundingClientRect().height;
+    const toggle = page.getByRole("button", { name: `${iconSize} bookmark` }).element();
+    const toggleRect = toggle.getBoundingClientRect();
+    const iconRect = toggle.querySelector("svg")!.getBoundingClientRect();
+
+    expect(toggleRect.height).toBe(textHeight);
+    expect(toggleRect.width).toBe(toggleRect.height);
+    expect(iconRect.left - toggleRect.left).toBeCloseTo(toggleRect.right - iconRect.right, 1);
+  }
+  await screen.unmount();
+});
+
+test.each(DENSITIES)("%s outline and default toggles with the same content have the same width", async (density) => {
+  await page.viewport(1024, 480);
+  const screen = await render(
+    <DensityProvider density={density}>
+      <div className="flex gap-2">
+        <Toggle aria-label="Default bookmark">
+          <BookmarkIcon />
+        </Toggle>
+        <Toggle variant="outline" aria-label="Outline bookmark">
+          <BookmarkIcon />
+        </Toggle>
+        <Toggle>Bold</Toggle>
+        <Toggle variant="outline">Bold outline</Toggle>
+      </div>
+    </DensityProvider>,
+  );
+  const readWidth = (name: string): number =>
+    page.getByRole("button", { name, exact: true }).element().getBoundingClientRect().width;
+  const readChromeWidth = (name: string): number => {
+    const range = document.createRange();
+    range.selectNodeContents(page.getByRole("button", { name, exact: true }).element());
+    return readWidth(name) - range.getBoundingClientRect().width;
+  };
+
+  expect(readWidth("Outline bookmark")).toBe(readWidth("Default bookmark"));
+  expect(readChromeWidth("Bold outline")).toBe(readChromeWidth("Bold"));
+  await screen.unmount();
+});
