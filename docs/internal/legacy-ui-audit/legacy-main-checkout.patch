+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import type { Density } from "../../density/types";
+import { AlertDialog, AlertDialogContent, AlertDialogTitle } from "../AlertDialog";
+import { Combobox, ComboboxContent, ComboboxInput, ComboboxItem, ComboboxList } from "../Combobox";
+import { ContextMenu, ContextMenuContent, ContextMenuTrigger } from "../ContextMenu";
+import { DensityProvider } from "../DensityProvider";
+import { Dialog, DialogContent, DialogTitle } from "../Dialog";
+import { Drawer, DrawerContent, DrawerTitle } from "../Drawer";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuSub,
+  DropdownMenuSubContent,
+  DropdownMenuSubTrigger,
+  DropdownMenuTrigger,
+} from "../DropdownMenu";
+import { HoverCard, HoverCardContent, HoverCardTrigger } from "../HoverCard";
+import {
+  Menubar,
+  MenubarContent,
+  MenubarMenu,
+  MenubarSub,
+  MenubarSubContent,
+  MenubarSubTrigger,
+  MenubarTrigger,
+} from "../Menubar";
+import {
+  NavigationMenu,
+  NavigationMenuContent,
+  NavigationMenuItem,
+  NavigationMenuList,
+  NavigationMenuTrigger,
+} from "../NavigationMenu";
+import { Popover, PopoverContent, PopoverTrigger } from "../Popover";
+import { Select, SelectContent, SelectTrigger, SelectValue } from "../Select";
+import { Sheet, SheetContent, SheetTitle } from "../Sheet";
+import { ThemeProvider } from "../ThemeProvider";
+import { ToastPortal, ToastProvider, ToastViewport } from "../Toast";
+import { Tooltip, TooltipContent, TooltipTrigger } from "../Tooltip";
+import "../../../.storybook/preview.css";
+
+function NestedTip(): ReactElement {
+  return (
+    <Tooltip defaultOpen>
+      <TooltipTrigger>Nested trigger</TooltipTrigger>
+      <TooltipContent>Nested tip</TooltipContent>
+    </Tooltip>
+  );
+}
+
+function Frame({ density, children }: { density: Density; children: ReactElement }): ReactElement {
+  return (
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>{children}</DensityProvider>
+    </ThemeProvider>
+  );
+}
+
+type Screen = Awaited<ReturnType<typeof render>>;
+
+async function measureNestedTipGap(screen: Screen): Promise<string> {
+  await expect.element(screen.getByText("Nested tip")).toBeInTheDocument();
+  const popup = screen.getByText("Nested tip").element().closest<HTMLElement>('[data-slot="tooltip-content"]')!;
+  return getComputedStyle(popup).columnGap;
+}
+
+async function measureReferenceGap(density: Density): Promise<string> {
+  const screen = await render(
+    <Frame density={density}>
+      <NestedTip />
+    </Frame>,
+  );
+  const gap = await measureNestedTipGap(screen);
+  await screen.unmount();
+  return gap;
+}
+
+const openFile = (screen: Screen) => screen.getByRole("menuitem", { name: "File" }).click();
+
+// Each popup overrides an inherited compact density; a portalled Tooltip nested inside must follow the override.
+const surfaces: [string, ReactElement, ((screen: Screen) => Promise<void>)?][] = [
+  [
+    "Popover",
+    <Popover defaultOpen>
+      <PopoverTrigger>Popover trigger</PopoverTrigger>
+      <PopoverContent density="comfortable">
+        <NestedTip />
+      </PopoverContent>
+    </Popover>,
+  ],
+  [
+    "HoverCard",
+    <HoverCard defaultOpen>
+      <HoverCardTrigger href="#profile">Hover card trigger</HoverCardTrigger>
+      <HoverCardContent density="comfortable">
+        <NestedTip />
+      </HoverCardContent>
+    </HoverCard>,
+  ],
+  [
+    "Dialog",
+    <Dialog defaultOpen>
+      <DialogContent density="comfortable">
+        <DialogTitle>Dialog surface</DialogTitle>
+        <NestedTip />
+      </DialogContent>
+    </Dialog>,
+  ],
+  [
+    "AlertDialog",
+    <AlertDialog defaultOpen>
+      <AlertDialogContent density="comfortable">
+        <AlertDialogTitle>Alert surface</AlertDialogTitle>
+        <NestedTip />
+      </AlertDialogContent>
+    </AlertDialog>,
+  ],
+  [
+    "Sheet",
+    <Sheet defaultOpen>
+      <SheetContent density="comfortable">
+        <SheetTitle>Sheet surface</SheetTitle>
+        <NestedTip />
+      </SheetContent>
+    </Sheet>,
+  ],
+  [
+    "Drawer",
+    <Drawer defaultOpen>
+      <DrawerContent density="comfortable">
+        <DrawerTitle>Drawer surface</DrawerTitle>
+        <NestedTip />
+      </DrawerContent>
+    </Drawer>,
+  ],
+  [
+    "DropdownMenu",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent density="comfortable">
+        <NestedTip />
+      </DropdownMenuContent>
+    </DropdownMenu>,
+  ],
+  [
+    "DropdownMenuSub",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent>
+        <DropdownMenuSub defaultOpen>
+          <DropdownMenuSubTrigger>Share</DropdownMenuSubTrigger>
+          <DropdownMenuSubContent density="comfortable">
+            <NestedTip />
+          </DropdownMenuSubContent>
+        </DropdownMenuSub>
+      </DropdownMenuContent>
+    </DropdownMenu>,
+  ],
+  [
+    "ContextMenu",
+    <ContextMenu>
+      <ContextMenuTrigger className="block p-panel">Context trigger</ContextMenuTrigger>
+      <ContextMenuContent density="comfortable">
+        <NestedTip />
+      </ContextMenuContent>
+    </ContextMenu>,
+    (screen) => screen.getByText("Context trigger").click({ button: "right" }),
+  ],
+  [
+    "Menubar",
+    <Menubar aria-label="Commands">
+      <MenubarMenu>
+        <MenubarTrigger>File</MenubarTrigger>
+        <MenubarContent density="comfortable">
+          <NestedTip />
+        </MenubarContent>
+      </MenubarMenu>
+    </Menubar>,
+    openFile,
+  ],
+  [
+    "MenubarSub",
+    <Menubar aria-label="Commands">
+      <MenubarMenu>
+        <MenubarTrigger>File</MenubarTrigger>
+        <MenubarContent>
+          <MenubarSub defaultOpen>
+            <MenubarSubTrigger>Share</MenubarSubTrigger>
+            <MenubarSubContent density="comfortable">
+              <NestedTip />
+            </MenubarSubContent>
+          </MenubarSub>
+        </MenubarContent>
+      </MenubarMenu>
+    </Menubar>,
+    openFile,
+  ],
+  [
+    "NavigationMenu",
+    <NavigationMenu aria-label="Main" defaultValue="products" density="comfortable">
+      <NavigationMenuList>
+        <NavigationMenuItem value="products">
+          <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+          <NavigationMenuContent>
+            <NestedTip />
+          </NavigationMenuContent>
+        </NavigationMenuItem>
+      </NavigationMenuList>
+    </NavigationMenu>,
+  ],
+  [
+    "NavigationMenuContent",
+    <NavigationMenu aria-label="Main" defaultValue="products">
+      <NavigationMenuList>
+        <NavigationMenuItem value="products">
+          <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+          <NavigationMenuContent density="comfortable">
+            <NestedTip />
+          </NavigationMenuContent>
+        </NavigationMenuItem>
+      </NavigationMenuList>
+    </NavigationMenu>,
+  ],
+  [
+    "Select",
+    <Select defaultOpen>
+      <SelectTrigger aria-label="Runtime">
+        <SelectValue placeholder="Select a runtime" />
+      </SelectTrigger>
+      <SelectContent density="comfortable">
+        <NestedTip />
+      </SelectContent>
+    </Select>,
+  ],
+  [
+    "Combobox",
+    <Combobox defaultOpen items={["Bun"]}>
+      <ComboboxInput aria-label="Runtime" />
+      <ComboboxContent density="comfortable">
+        <ComboboxList>
+          {(item: string) => (
+            <ComboboxItem key={item} value={item}>
+              {item}
+            </ComboboxItem>
+          )}
+        </ComboboxList>
+        <NestedTip />
+      </ComboboxContent>
+    </Combobox>,
+  ],
+  [
+    "ToastViewport",
+    <ToastProvider>
+      <ToastPortal>
+        <ToastViewport density="comfortable">
+          <NestedTip />
+        </ToastViewport>
+      </ToastPortal>
+    </ToastProvider>,
+  ],
+  [
+    "Tooltip",
+    <Tooltip defaultOpen>
+      <TooltipTrigger>Outer trigger</TooltipTrigger>
+      <TooltipContent density="comfortable">
+        <NestedTip />
+      </TooltipContent>
+    </Tooltip>,
+  ],
+];
+
+test.each(surfaces)("%s density override reaches a nested portalled Tooltip", async (_name, surface, open) => {
+  const comfortableGap = await measureReferenceGap("comfortable");
+  // Guard: the probe must distinguish the two densities, or the assertion below proves nothing.
+  expect(await measureReferenceGap("compact")).not.toBe(comfortableGap);
+
+  const screen = await render(<Frame density="compact">{surface}</Frame>);
+  await open?.(screen);
+  expect(await measureNestedTipGap(screen)).toBe(comfortableGap);
+  await screen.unmount();
+});
diff --git a/src/components/__tests__/Notifications.test.tsx b/src/components/__tests__/Notifications.test.tsx
