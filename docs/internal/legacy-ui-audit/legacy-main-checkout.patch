@@ -0,0 +1,97 @@
+import { FileIcon } from "lucide-react";
+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { Density } from "../../density/types";
+import { Attachment, AttachmentContent, AttachmentDescription, AttachmentMedia, AttachmentTitle } from "../Attachment";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+const DENSITIES = ["comfortable", "compact"] satisfies Density[];
+const SIZES = ["default", "sm", "xs"] as const;
+const METRICS = ["inline", "height", "gap"] as const;
+
+type Size = (typeof SIZES)[number];
+type Metric = (typeof METRICS)[number];
+type Spacing = Record<Metric, number>;
+
+const DIRECTIONS = [
+  { dir: "ltr", offset: (media: DOMRect, text: DOMRect) => text.left - media.left },
+  { dir: "rtl", offset: (media: DOMRect, text: DOMRect) => media.right - text.right },
+] as const;
+
+async function measureSpacing(density: Density): Promise<Record<Size, Spacing>> {
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>
+        <div className="flex flex-col items-start gap-4">
+          {SIZES.map((size) => (
+            <Attachment key={size} data-testid={`${size}-attachment`} size={size}>
+              <AttachmentMedia data-testid={`${size}-media`}>
+                <FileIcon />
+              </AttachmentMedia>
+              <AttachmentContent data-testid={`${size}-content`}>
+                <AttachmentTitle>report.pdf</AttachmentTitle>
+                <AttachmentDescription>2.4 MB</AttachmentDescription>
+              </AttachmentContent>
+            </Attachment>
+          ))}
+        </div>
+      </DensityProvider>
+    </ThemeProvider>,
+  );
+  const rect = (testId: string) => screen.getByTestId(testId).element().getBoundingClientRect();
+  const spacing = (size: Size): Spacing => ({
+    inline: rect(`${size}-media`).left - rect(`${size}-attachment`).left,
+    height: rect(`${size}-attachment`).height,
+    gap: rect(`${size}-content`).left - rect(`${size}-media`).right,
+  });
+  const measured = { default: spacing("default"), sm: spacing("sm"), xs: spacing("xs") };
+  await screen.unmount();
+  return measured;
+}
+
+// Each smaller size must be at most as roomy or tall as the size above it in every density, and density must shrink every size.
+test("attachment sizes step down consistently and follow density", async () => {
+  const comfortable = await measureSpacing("comfortable");
+  const compact = await measureSpacing("compact");
+  const byDensity = { comfortable, compact };
+
+  for (const density of DENSITIES) {
+    for (const metric of METRICS) {
+      const values = SIZES.map((size) => byDensity[density][size][metric]);
+      expect({ density, metric, values }).toEqual({ density, metric, values: values.toSorted((a, b) => b - a) });
+    }
+  }
+  for (const size of SIZES) {
+    for (const metric of METRICS) {
+      const isDenser = compact[size][metric] < comfortable[size][metric];
+      expect({ size, metric, isDenser }).toEqual({ size, metric, isDenser: true });
+    }
+  }
+});
+
+// A vertical card stacks text under its thumbnail, so the text must share the thumbnail's inline-start edge.
+test("vertical attachment text aligns with its thumbnail edge", async () => {
+  for (const { dir, offset } of DIRECTIONS) {
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <div dir={dir}>
+          <Attachment orientation="vertical">
+            <AttachmentMedia data-testid="media">
+              <FileIcon />
+            </AttachmentMedia>
+            <AttachmentContent>
+              <AttachmentTitle data-testid="title">report.pdf</AttachmentTitle>
+            </AttachmentContent>
+          </Attachment>
+        </div>
+      </ThemeProvider>,
+    );
+    const media = screen.getByTestId("media").element().getBoundingClientRect();
+    const title = screen.getByTestId("title").element().getBoundingClientRect();
+
+    expect({ dir, offset: offset(media, title) }).toEqual({ dir, offset: 0 });
+    await screen.unmount();
+  }
+});
