+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import { Alert, AlertDescription, AlertTitle } from "../Alert";
+import { Card, CardContent } from "../Card";
+import {
+  NavigationMenu,
+  NavigationMenuContent,
+  NavigationMenuItem,
+  NavigationMenuLink,
+  NavigationMenuList,
+  NavigationMenuTrigger,
+} from "../NavigationMenu";
+import { Tabs, TabsList, TabsTrigger } from "../Tabs";
+import "../../../.storybook/preview.css";
+
+type Nesting = [name: string, surface: ReactElement, parent: string, child: string];
+
+function readRadius(selector: string): number {
+  const element = document.querySelector<HTMLElement>(selector);
+  if (!element) throw new Error(`Missing ${selector}`);
+  return Number.parseFloat(getComputedStyle(element).borderTopLeftRadius);
+}
+
+const nestings: Nesting[] = [
+  [
+    "TabsTrigger in TabsList",
+    <Tabs defaultValue="overview">
+      <TabsList>
+        <TabsTrigger value="overview">Overview</TabsTrigger>
+      </TabsList>
+    </Tabs>,
+    '[data-slot="tabs-list"]',
+    '[data-slot="tabs-trigger"]',
+  ],
+  [
+    "NavigationMenuLink in the popup",
+    <NavigationMenu aria-label="Main" defaultValue="products">
+      <NavigationMenuList>
+        <NavigationMenuItem value="products">
+          <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+          <NavigationMenuContent>
+            <NavigationMenuLink href="#components">Components</NavigationMenuLink>
+          </NavigationMenuContent>
+        </NavigationMenuItem>
+      </NavigationMenuList>
+    </NavigationMenu>,
+    '[data-slot="navigation-menu-popup"]',
+    '[data-slot="navigation-menu-link"]',
+  ],
+];
+
+// A child that rounds more than the container it sits in leaves the container's corner visibly sharper than the
+// element inside it.
+test.each(nestings)("%s does not round more than its container", async (_name, surface, parent, child) => {
+  const screen = await render(surface);
+  await expect.poll(() => document.querySelector(child)).not.toBeNull();
+
+  expect(readRadius(child)).toBeLessThanOrEqual(readRadius(parent));
+  await screen.unmount();
+});
+
+// Alert and Card are both bordered, panel-padded block surfaces, so they share the panel radius tier.
+test("Alert uses the same panel radius as Card", async () => {
+  const screen = await render(
+    <>
+      <Alert>
+        <AlertTitle>Saved</AlertTitle>
+        <AlertDescription>Changes are live.</AlertDescription>
+      </Alert>
+      <Card>
+        <CardContent>Summary</CardContent>
+      </Card>
+    </>,
+  );
+
+  expect(readRadius('[data-slot="alert"]')).toBe(readRadius('[data-slot="card"]'));
+  await screen.unmount();
+});
