@@ -0,0 +1,45 @@
+import { afterEach, expect } from "vitest";
+
+// Smallest separation between sibling story roots that still reads as two distinct elements.
+const MIN_SIBLING_GAP = 4;
+
+function describeElement(element: Element): string {
+  const name = element.getAttribute("aria-label") ?? element.getAttribute("data-slot") ?? "";
+  return `${element.tagName.toLowerCase()}[${name}]`;
+}
+
+function describeRenderedChildren(parent: Element | null): { element: Element; rect: DOMRect }[] {
+  return Array.from(parent?.children ?? []).flatMap((element) => {
+    const rect = element.getBoundingClientRect();
+    const style = getComputedStyle(element);
+    const isInFlow = style.position !== "absolute" && style.position !== "fixed";
+    return rect.width > 0 && rect.height > 0 && style.visibility !== "hidden" && isInFlow ? [{ element, rect }] : [];
+  });
+}
+
+// A lone story-authored div or form (components mark their roots with data-slot) only groups the story roots.
+function isStoryWrapper(element: Element): boolean {
+  return (element.tagName === "DIV" || element.tagName === "FORM") && !element.hasAttribute("data-slot");
+}
+
+// Describes consecutive rendered roots of the preview column that touch or nearly touch each other.
+function describeTouchingStoryRoots(): string[] {
+  let roots = describeRenderedChildren(document.querySelector('[data-preview-frame="column"]'));
+  while (roots.length === 1 && isStoryWrapper(roots[0]!.element)) {
+    roots = describeRenderedChildren(roots[0]!.element);
+  }
+  return roots.slice(1).flatMap((current, index) => {
+    const previous = roots[index]!;
+    const isSameLine = current.rect.top < previous.rect.bottom - 0.5;
+    const gap = isSameLine
+      ? Math.max(current.rect.left - previous.rect.right, previous.rect.left - current.rect.right)
+      : current.rect.top - previous.rect.bottom;
+    return gap < MIN_SIBLING_GAP
+      ? [`${describeElement(previous.element)} -> ${describeElement(current.element)} ${gap.toFixed(1)}px`]
+      : [];
+  });
+}
+
+afterEach(async () => {
+  await expect.poll(describeTouchingStoryRoots).toEqual([]);
+});
diff --git a/.storybook/narrow.setup.ts b/.storybook/narrow.setup.ts
new file mode 100644
index 0000000..bc0ee02
--- /dev/null
+++ b/.storybook/narrow.setup.ts
@@ -0,0 +1,32 @@
+import { afterEach, expect } from "vitest";
+import { page } from "vitest/browser";
+
+// The narrowest common phone layout width; every story must fit it without horizontal overflow.
+const NARROW_WIDTH = 320;
+
+function hasClippingAncestor(element: Element): boolean {
+  for (let parent = element.parentElement; parent && parent !== document.body; parent = parent.parentElement) {
+    const style = getComputedStyle(parent);
+    if (style.overflowX !== "visible" || style.clipPath !== "none") return true;
+  }
+  return false;
+}
+
+// Describes each rendered box that extends past the viewport's inline edges where no ancestor clips it.
+function describeViewportOverflow(): string[] {
+  const viewportWidth = document.documentElement.clientWidth;
+  return Array.from(document.body.querySelectorAll("*")).flatMap((element) => {
+    const rect = element.getBoundingClientRect();
+    const style = getComputedStyle(element);
+    const overflow = Math.max(-rect.left, rect.right - viewportWidth);
+    const isRendered = rect.width >= 1 && rect.height >= 1 && style.visibility !== "hidden";
+    if (!isRendered || style.clipPath !== "none" || overflow <= 0.5 || hasClippingAncestor(element)) return [];
+    const name = element.getAttribute("aria-label") ?? element.getAttribute("data-slot") ?? "";
+    return [`${element.tagName.toLowerCase()}[${name}] ${Math.round(rect.left)}..${Math.round(rect.right)}`];
+  });
+}
+
+afterEach(async () => {
+  await page.viewport(NARROW_WIDTH, 800);
+  await expect.poll(describeViewportOverflow).toEqual([]);
+});
