+import { page } from "vitest/browser";
+
+export type Rgba = [number, number, number, number];
+
+export const COLOR_TOLERANCE = 24;
+
+export function isSameColor(left: Rgba, right: Rgba): boolean {
+  return left.every((channel, index) => Math.abs(channel - right[index]!) <= COLOR_TOLERANCE);
+}
+
+// Screenshots an element as rendered by the browser and decodes it, so assertions see composited pixels rather than
+// computed styles.
+export async function captureImageData(element: Element): Promise<ImageData> {
+  const base64 = await page.elementLocator(element).screenshot({ save: false });
+  const blob = await (await fetch(`data:image/png;base64,${base64}`)).blob();
+  const bitmap = await createImageBitmap(blob);
+  const canvas = new OffscreenCanvas(bitmap.width, bitmap.height);
+  const context = canvas.getContext("2d")!;
+  context.drawImage(bitmap, 0, 0);
+  return context.getImageData(0, 0, bitmap.width, bitmap.height);
+}
+
+export function readPixel(image: ImageData, x: number, y: number): Rgba {
+  const offset = (y * image.width + x) * 4;
+  const { data } = image;
+  return [data[offset]!, data[offset + 1]!, data[offset + 2]!, data[offset + 3]!];
+}
+
+// How far an inner border box pokes above or below an outer border box; 0 when it is contained vertically.
+export function measureBlockOverflow(inner: Element, outer: Element): number {
+  const innerRect = inner.getBoundingClientRect();
+  const outerRect = outer.getBoundingClientRect();
+  return Math.max(0, outerRect.top - innerRect.top, innerRect.bottom - outerRect.bottom);
+}
+
+// How far an inner border box pokes out of an outer border box on its furthest side; 0 when it is contained.
+export function measureOverflow(inner: Element, outer: Element): number {
+  const innerRect = inner.getBoundingClientRect();
+  const outerRect = outer.getBoundingClientRect();
+  return Math.max(
+    measureBlockOverflow(inner, outer),
+    outerRect.left - innerRect.left,
+    innerRect.right - outerRect.right,
+  );
+}
+
+export function countChangedPixels(before: ImageData, after: ImageData): number {
+  let count = 0;
+  for (let y = 0; y < before.height; y += 1) {
+    for (let x = 0; x < before.width; x += 1) {
+      if (!isSameColor(readPixel(before, x, y), readPixel(after, x, y))) {
+        count += 1;
+      }
+    }
+  }
+  return count;
+}
