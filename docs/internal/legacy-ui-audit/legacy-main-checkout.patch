+import { expect, test } from "vitest";
+import { render } from "vitest-browser-react";
+import type { ReactElement } from "react";
+import type { Density } from "../../density/types";
+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "../Accordion";
+import { Button } from "../Button";
+import { Combobox, ComboboxContent, ComboboxInput, ComboboxItem, ComboboxList } from "../Combobox";
+import { Command, CommandGroup, CommandItem, CommandList } from "../Command";
+import {
+  ContextMenu,
+  ContextMenuCheckboxItem,
+  ContextMenuContent,
+  ContextMenuItem,
+  ContextMenuTrigger,
+} from "../ContextMenu";
+import { DensityProvider } from "../DensityProvider";
+import {
+  DropdownMenu,
+  DropdownMenuCheckboxItem,
+  DropdownMenuContent,
+  DropdownMenuGroup,
+  DropdownMenuItem,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSub,
+  DropdownMenuSubContent,
+  DropdownMenuSubTrigger,
+  DropdownMenuTrigger,
+} from "../DropdownMenu";
+import { Field, FieldContent, FieldDescription, FieldLabel, FieldTitle } from "../Field";
+import { Menubar, MenubarContent, MenubarItem, MenubarMenu, MenubarTrigger } from "../Menubar";
+import { Popover, PopoverContent, PopoverTrigger } from "../Popover";
+import { RadioGroup, RadioGroupItem } from "../RadioGroup";
+import { Select, SelectContent, SelectGroup, SelectItem, SelectTrigger, SelectValue } from "../Select";
+import { Tabs, TabsList, TabsTrigger } from "../Tabs";
+import { ThemeProvider } from "../ThemeProvider";
+import { Tooltip, TooltipContent, TooltipTrigger } from "../Tooltip";
+import "../../../.storybook/preview.css";
+
+type Screen = Awaited<ReturnType<typeof render>>;
+type Metric = (element: HTMLElement) => number;
+
+const height: Metric = (element) => element.getBoundingClientRect().height;
+const paddingTop: Metric = (element) => Number.parseFloat(getComputedStyle(element).paddingTop);
+const paddingInlineStart: Metric = (element) => Number.parseFloat(getComputedStyle(element).paddingInlineStart);
+
+async function measure(
+  density: Density,
+  surface: ReactElement,
+  selector: string,
+  metric: Metric,
+  open?: (screen: Screen) => Promise<void>,
+): Promise<number> {
+  const screen = await render(
+    <ThemeProvider forcedTheme="light">
+      <DensityProvider density={density}>{surface}</DensityProvider>
+    </ThemeProvider>,
+  );
+  await open?.(screen);
+  await expect.poll(() => document.querySelector(selector)).not.toBeNull();
+  const value = metric(document.querySelector<HTMLElement>(selector)!);
+  await screen.unmount();
+  return value;
+}
+
+async function measureBoth(
+  surface: ReactElement,
+  selector: string,
+  metric: Metric,
+  open?: (screen: Screen) => Promise<void>,
+): Promise<Record<Density, number>> {
+  return {
+    comfortable: await measure("comfortable", surface, selector, metric, open),
+    compact: await measure("compact", surface, selector, metric, open),
+  };
+}
+
+const commandRow = (
+  <Command>
+    <CommandList>
+      <CommandGroup>
+        <CommandItem>Reference row</CommandItem>
+      </CommandGroup>
+    </CommandList>
+  </Command>
+);
+
+const openFile = (screen: Screen) => screen.getByRole("menuitem", { name: "File" }).click();
+const openContext = (screen: Screen) => screen.getByText("Context trigger").click({ button: "right" });
+
+// Every selectable popup row follows the Command row precedent: one control-height row per density.
+const menuRows: [string, ReactElement, string, ((screen: Screen) => Promise<void>)?][] = [
+  [
+    "DropdownMenuItem",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent>
+        <DropdownMenuGroup>
+          <DropdownMenuItem>Rename</DropdownMenuItem>
+        </DropdownMenuGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>,
+    '[data-slot="dropdown-menu-item"]',
+  ],
+  [
+    "DropdownMenuCheckboxItem",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent>
+        <DropdownMenuGroup>
+          <DropdownMenuCheckboxItem checked>Status bar</DropdownMenuCheckboxItem>
+        </DropdownMenuGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>,
+    '[data-slot="dropdown-menu-checkbox-item"]',
+  ],
+  [
+    "DropdownMenuRadioItem",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent>
+        <DropdownMenuRadioGroup value="top">
+          <DropdownMenuRadioItem value="top">Top</DropdownMenuRadioItem>
+        </DropdownMenuRadioGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>,
+    '[data-slot="dropdown-menu-radio-item"]',
+  ],
+  [
+    "DropdownMenuSubTrigger",
+    <DropdownMenu defaultOpen>
+      <DropdownMenuTrigger>Dropdown trigger</DropdownMenuTrigger>
+      <DropdownMenuContent>
+        <DropdownMenuSub>
+          <DropdownMenuSubTrigger>Share</DropdownMenuSubTrigger>
+          <DropdownMenuSubContent>
+            <DropdownMenuItem>Email</DropdownMenuItem>
+          </DropdownMenuSubContent>
+        </DropdownMenuSub>
+      </DropdownMenuContent>
+    </DropdownMenu>,
+    '[data-slot="dropdown-menu-sub-trigger"]',
+  ],
+  [
+    "ContextMenuItem",
+    <ContextMenu>
+      <ContextMenuTrigger className="block p-panel">Context trigger</ContextMenuTrigger>
+      <ContextMenuContent>
+        <ContextMenuItem>Back</ContextMenuItem>
+      </ContextMenuContent>
+    </ContextMenu>,
+    '[data-slot="context-menu-item"]',
+    openContext,
+  ],
+  [
+    "ContextMenuCheckboxItem",
+    <ContextMenu>
+      <ContextMenuTrigger className="block p-panel">Context trigger</ContextMenuTrigger>
+      <ContextMenuContent>
+        <ContextMenuCheckboxItem checked>Show bookmarks</ContextMenuCheckboxItem>
+      </ContextMenuContent>
+    </ContextMenu>,
+    '[data-slot="context-menu-checkbox-item"]',
+    openContext,
+  ],
+  [
+    "MenubarItem",
+    <Menubar aria-label="Commands">
+      <MenubarMenu>
+        <MenubarTrigger>File</MenubarTrigger>
+        <MenubarContent>
+          <MenubarItem>New tab</MenubarItem>
+        </MenubarContent>
+      </MenubarMenu>
+    </Menubar>,
+    '[data-slot="menubar-item"]',
+    openFile,
+  ],
+  [
+    "SelectItem",
+    <Select defaultOpen defaultValue="bun">
+      <SelectTrigger aria-label="Runtime">
+        <SelectValue />
+      </SelectTrigger>
+      <SelectContent>
+        <SelectGroup>
+          <SelectItem value="bun">Bun</SelectItem>
+        </SelectGroup>
+      </SelectContent>
+    </Select>,
+    '[data-slot="select-item"]',
+  ],
+  [
+    "ComboboxItem",
+    <Combobox defaultOpen items={["Bun"]}>
+      <ComboboxInput aria-label="Runtime" />
+      <ComboboxContent>
+        <ComboboxList>
+          {(item: string) => (
+            <ComboboxItem key={item} value={item}>
+              {item}
+            </ComboboxItem>
+          )}
+        </ComboboxList>
+      </ComboboxContent>
+    </Combobox>,
+    '[data-slot="combobox-item"]',
+  ],
+];
+
+test.each(menuRows)("%s rows follow density like Command rows", async (_name, surface, selector, open) => {
+  const reference = await measureBoth(commandRow, '[data-slot="command-item"]', height);
+  // Guard: the reference row must distinguish the two densities, or the comparison below proves nothing.
+  expect(reference.compact).toBeLessThan(reference.comfortable);
+
+  expect(await measureBoth(surface, selector, height, open)).toEqual(reference);
+});
+
+function tabsOf(orientation: "horizontal" | "vertical"): ReactElement {
+  return (
+    <Tabs defaultValue="overview" orientation={orientation}>
+      <TabsList>
+        <TabsTrigger value="overview">Overview</TabsTrigger>
+        <TabsTrigger value="usage">Usage</TabsTrigger>
+      </TabsList>
+    </Tabs>
+  );
+}
+
+test("vertical tab triggers keep the horizontal trigger height in each density", async () => {
+  const horizontal = await measureBoth(tabsOf("horizontal"), '[data-slot="tabs-trigger"]', height);
+  expect(horizontal.compact).toBeLessThan(horizontal.comfortable);
+
+  expect(await measureBoth(tabsOf("vertical"), '[data-slot="tabs-trigger"]', height)).toEqual(horizontal);
+});
+
+test("menubar triggers match tab triggers in each density", async () => {
+  const tabs = await measureBoth(tabsOf("horizontal"), '[data-slot="tabs-trigger"]', height);
+  const menubar = (
+    <Menubar aria-label="Commands">
+      <MenubarMenu>
+        <MenubarTrigger>File</MenubarTrigger>
+      </MenubarMenu>
+    </Menubar>
+  );
+
+  expect(await measureBoth(menubar, '[data-slot="menubar-trigger"]', height)).toEqual(tabs);
+});
+
+const choiceCard = (
+  <RadioGroup defaultValue="cluster" aria-label="Compute environment">
+    <FieldLabel htmlFor="density-choice-cluster">
+      <Field orientation="horizontal">
+        <FieldContent>
+          <FieldTitle>Cluster</FieldTitle>
+          <FieldDescription>Run workloads together.</FieldDescription>
+        </FieldContent>
+        <RadioGroupItem id="density-choice-cluster" value="cluster" />
+      </Field>
+    </FieldLabel>
+  </RadioGroup>
+);
+
+// Disclosure rows, choice cards and floating surfaces have no shared row height, so they only need to tighten.
+const tightening: [string, ReactElement, string, Metric][] = [
+  [
+    "AccordionTrigger height",
+    <Accordion>
+      <AccordionItem value="shipping">
+        <AccordionTrigger>Shipping</AccordionTrigger>
+        <AccordionContent>Ships in two days.</AccordionContent>
+      </AccordionItem>
+    </Accordion>,
+    '[data-slot="accordion-trigger"]',
+    height,
+  ],
+  ["Field choice card inset", choiceCard, '[data-slot="field-label"] > [data-slot="field"]', paddingTop],
+  [
+    "PopoverContent inset",
+    <Popover defaultOpen>
+      <PopoverTrigger>Popover trigger</PopoverTrigger>
+      <PopoverContent>Popover body</PopoverContent>
+    </Popover>,
+    '[data-slot="popover-content"]',
+    paddingTop,
+  ],
+  [
+    "TooltipContent height",
