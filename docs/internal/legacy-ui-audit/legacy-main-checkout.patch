+function DensityStack({ id, expand }: { id: string; expand: boolean }): ReactElement {
+  const [isCompact, setCompact] = useState(true);
+  return (
+    <DensityProvider density={isCompact ? "compact" : "comfortable"}>
+      <Sonner id={id} expand={expand} position="top-center" duration={Infinity} closeButton />
+      <div className="flex flex-wrap items-center gap-control-gap pt-64">
+        <Button
+          onClick={() => {
+            for (const label of ["First", "Second", "Latest"]) {
+              toast.success(`${label} density notification`, { id: `${id}-${label}`, toasterId: id });
+            }
+          }}
+        >
+          Create stack
+        </Button>
+        <Button onClick={() => setCompact((value) => !value)}>Change density</Button>
+      </div>
+    </DensityProvider>
+  );
+}
+
+async function changeDensityAndMeasure(canvasElement: HTMLElement): Promise<HTMLElement[]> {
+  const canvas = within(canvasElement);
+  await userEvent.click(canvas.getByRole("button", { name: "Create stack" }));
+  const notifications = await Promise.all(
+    ["First", "Second", "Latest"].map(async (label) =>
+      (await canvas.findByText(`${label} density notification`)).closest<HTMLElement>("[data-sonner-toast]")!,
+    ),
+  );
+  await waitFor(() => expect(notifications[2]!.getBoundingClientRect().height).toBe(36));
+  await userEvent.click(canvas.getByRole("button", { name: "Change density" }));
+  // Open notifications follow the density change instead of keeping the height measured when they appeared.
+  for (const notification of notifications) {
+    await waitFor(() => expect(notification.getBoundingClientRect().height).toBe(60));
+  }
+  return notifications;
+}
+
+async function restoreDensityAndDismiss(canvasElement: HTMLElement, notifications: HTMLElement[]): Promise<void> {
+  const canvas = within(canvasElement);
+  await userEvent.click(canvas.getByRole("button", { name: "Change density" }));
+  for (const notification of notifications) {
+    await waitFor(() => expect(notification.getBoundingClientRect().height).toBe(36));
+  }
+  toast.dismiss();
+  await waitFor(() => expect(canvas.queryByText("Latest density notification")).toBeNull());
+}
+
+export const DensityChange: Story = {
+  render: () => <DensityStack id="sonner-density" expand={false} />,
+  play: async ({ canvasElement }) => {
+    const notifications = await changeDensityAndMeasure(canvasElement);
+    await restoreDensityAndDismiss(canvasElement, notifications);
+  },
+};
+
+export const DensityChangeExpanded: Story = {
+  render: () => <DensityStack id="sonner-density-expanded" expand />,
+  play: async ({ canvasElement }) => {
+    const [first, second, latest] = await changeDensityAndMeasure(canvasElement);
+    // Expanded stacks restack with the new heights, so taller notifications do not overlap.
+    await waitFor(() =>
+      expect(second!.getBoundingClientRect().top - latest!.getBoundingClientRect().bottom).toBeGreaterThanOrEqual(14),
+    );
+    await waitFor(() =>
+      expect(first!.getBoundingClientRect().top - second!.getBoundingClientRect().bottom).toBeGreaterThanOrEqual(14),
+    );
+    await restoreDensityAndDismiss(canvasElement, [first!, second!, latest!]);
+  },
+};
