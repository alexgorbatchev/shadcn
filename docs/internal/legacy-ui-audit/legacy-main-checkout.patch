diff --git a/src/components/__tests__/NavigationMenu.test.tsx b/src/components/__tests__/NavigationMenu.test.tsx
new file mode 100644
index 0000000..dc96b0b
--- /dev/null
+++ b/src/components/__tests__/NavigationMenu.test.tsx
@@ -0,0 +1,141 @@
+import { expect, test } from "vitest";
+import { page, userEvent } from "vitest/browser";
+import { render } from "vitest-browser-react";
+import {
+  NavigationMenu,
+  NavigationMenuContent,
+  NavigationMenuItem,
+  NavigationMenuLink,
+  NavigationMenuList,
+  NavigationMenuTrigger,
+  navigationMenuTriggerStyle,
+} from "../NavigationMenu";
+import { DensityProvider } from "../DensityProvider";
+import { ThemeProvider } from "../ThemeProvider";
+import "../../../.storybook/preview.css";
+
+type TranslateSamples = Map<string, number[]>;
+
+function readTranslateX(element: HTMLElement): number {
+  const { translate } = getComputedStyle(element);
+  return translate === "none" ? 0 : Number.parseFloat(translate);
+}
+
+// Records the horizontal offset of every mounted panel on each frame, keyed by the panel's link text.
+function sampleContentTranslate(durationMs: number): Promise<TranslateSamples> {
+  return new Promise((resolve) => {
+    const samples: TranslateSamples = new Map();
+    const startedAt = performance.now();
+    const sample = (now: number) => {
+      for (const content of document.querySelectorAll<HTMLElement>('[data-slot="navigation-menu-content"]')) {
+        const label = content.textContent ?? "";
+        samples.set(label, [...(samples.get(label) ?? []), readTranslateX(content)]);
+      }
+      if (now - startedAt < durationMs) requestAnimationFrame(sample);
+      else resolve(samples);
+    };
+    requestAnimationFrame(sample);
+  });
+}
+
+function samplesFor(samples: TranslateSamples, label: string): number[] {
+  const values = samples.get(label);
+  if (!values) throw new Error(`No frames sampled for ${label}`);
+  return values;
+}
+
+async function expectSettledOn(label: string): Promise<void> {
+  await expect
+    .poll(() =>
+      [...document.querySelectorAll<HTMLElement>('[data-slot="navigation-menu-content"]')].map((content) => ({
+        label: content.textContent,
+        opacity: getComputedStyle(content).opacity,
+        translateX: readTranslateX(content),
+      })),
+    )
+    .toEqual([{ label, opacity: "1", translateX: 0 }]);
+}
+
+test("switching panels slides the outgoing and incoming content in the activation direction", async () => {
+  await page.viewport(800, 480);
+  const screen = await render(
+    <NavigationMenu aria-label="Main navigation">
+      <NavigationMenuList>
+        <NavigationMenuItem value="products">
+          <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+          <NavigationMenuContent>
+            <NavigationMenuLink href="#components">Components</NavigationMenuLink>
+          </NavigationMenuContent>
+        </NavigationMenuItem>
+        <NavigationMenuItem value="learn">
+          <NavigationMenuTrigger>Learn</NavigationMenuTrigger>
+          <NavigationMenuContent>
+            <NavigationMenuLink href="#guides">Guides</NavigationMenuLink>
+          </NavigationMenuContent>
+        </NavigationMenuItem>
+      </NavigationMenuList>
+    </NavigationMenu>,
+  );
+
+  await userEvent.click(screen.getByRole("button", { name: "Products" }));
+  await expectSettledOn("Components");
+
+  // Pointing at another trigger switches panels; clicking it would toggle the newly active panel closed.
+  // Moving to a later trigger: the new panel enters from the right while the old one leaves to the left.
+  const rightward = sampleContentTranslate(500);
+  await userEvent.hover(screen.getByRole("button", { name: "Learn" }));
+  const rightwardSamples = await rightward;
+  expect(Math.max(...samplesFor(rightwardSamples, "Guides"))).toBeGreaterThan(0);
+  expect(Math.min(...samplesFor(rightwardSamples, "Components"))).toBeLessThan(0);
+  await expectSettledOn("Guides");
+
+  // Moving back reverses both directions.
+  const leftward = sampleContentTranslate(500);
+  await userEvent.hover(screen.getByRole("button", { name: "Products" }));
+  const leftwardSamples = await leftward;
+  expect(Math.min(...samplesFor(leftwardSamples, "Components"))).toBeLessThan(0);
+  expect(Math.max(...samplesFor(leftwardSamples, "Guides"))).toBeGreaterThan(0);
+  await expectSettledOn("Components");
+  await screen.unmount();
+});
+
+test.each(["comfortable", "compact"] as const)(
+  "%s top-level link composed with the trigger style matches the trigger box",
+  async (density) => {
+    await page.viewport(800, 480);
+    const screen = await render(
+      <ThemeProvider forcedTheme="light">
+        <DensityProvider density={density}>
+          <NavigationMenu aria-label="Main navigation">
+            <NavigationMenuList>
+              <NavigationMenuItem value="products">
+                <NavigationMenuTrigger>Products</NavigationMenuTrigger>
+                <NavigationMenuContent>
+                  <NavigationMenuLink href="#components">Components</NavigationMenuLink>
+                </NavigationMenuContent>
+              </NavigationMenuItem>
+              <NavigationMenuItem>
+                <NavigationMenuLink href="#about" className={navigationMenuTriggerStyle()}>
+                  About
+                </NavigationMenuLink>
+              </NavigationMenuItem>
+            </NavigationMenuList>
+          </NavigationMenu>
+        </DensityProvider>
+      </ThemeProvider>,
+    );
+    const trigger = screen.getByRole("button", { name: "Products" });
+    const link = screen.getByRole("link", { name: "About" });
+    await expect.element(link).toBeVisible();
+    const triggerRect = trigger.element().getBoundingClientRect();
+    const linkRect = link.element().getBoundingClientRect();
+    const triggerStyle = getComputedStyle(trigger.element());
+    const linkStyle = getComputedStyle(link.element());
+
+    expect(linkRect.height).toBeCloseTo(triggerRect.height, 1);
+    expect(linkRect.top).toBeCloseTo(triggerRect.top, 1);
+    expect(linkStyle.paddingInlineStart).toBe(triggerStyle.paddingInlineStart);
+    expect(linkStyle.fontWeight).toBe(triggerStyle.fontWeight);
+    await screen.unmount();
+  },
+);
