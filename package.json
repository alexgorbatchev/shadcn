{
  "name": "@alexgorbatchev/shadcn",
  "version": "0.0.3",
  "description": "Sharp, monospace React components with compact and comfortable densities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/shadcn.git"
  },
  "files": [
    "dist",
    "patches",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./typeset.css": "./dist/typeset.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run --config .storybook/vitest.config.ts && bun run test:native && bun run test:package",
    "test:package": "bun run build && bun test scripts/__tests__/build.test.ts",
    "test:native": "vitest run --config .storybook/vitest.native.config.ts",
    "test:coverage": "vitest run --config .storybook/vitest.config.ts --coverage",
    "test:contrast": "vitest run --config .storybook/vitest.contrast.config.ts",
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src .storybook scripts && oxfmt --check . && bun run lint:unused",
    "lint:unused": "bun --bun ts-unused check tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepack": "bun run build",
    "test:reduced-motion": "vitest run --config .storybook/vitest.reduced-motion.config.ts",
    "test:visual": "vitest run --config .storybook/vitest.visual.config.ts Button.stories.tsx Badge.stories.tsx Card.stories.tsx Input.stories.tsx",
    "test:visual:update": "bun run test:visual --update"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/persian": "^10.0.2",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cssesc": "3.0.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "1.52.0",
    "input-otp": "1.5.0",
    "lucide-react": "^1.53.0",
    "react-resizable-panels": "^4.14.3",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.13",
    "@types/bun": "^1.4.2",
    "@types/cssesc": "3.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "bun": "1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "chrono-node": "^2.10.2",
    "embla-carousel-autoplay": "8.6.0",
    "motion": "14.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "react-hook-form": "7.89.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "ts-unused": "3.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.6",
    "vitest-browser-react": "^2.3.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@shadcn/react@0.3.1": "patches/@shadcn%2Freact@0.3.1.patch",
    "sonner@2.0.8": "patches/sonner@2.0.8.patch",
    "input-otp@1.5.0": "patches/input-otp@1.5.0.patch"
  }
}
