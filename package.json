{
  "name": "shadcn-alexgorbatchev",
  "version": "0.1.0",
  "description": "Sharp, monospace React components with compact and comfortable densities.",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src .storybook scripts && oxfmt --check .",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-plugin-tailwind": "^0.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.0"
}
