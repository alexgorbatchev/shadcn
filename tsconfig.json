{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@alexgorbatchev/shadcn": ["./src/index.ts"]
    }
  },
  "include": ["src", ".storybook/**/*.ts", ".storybook/**/*.tsx", "scripts", "cli"]
}
