{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", ".storybook/**/*.ts", ".storybook/**/*.tsx", "scripts"]
}
